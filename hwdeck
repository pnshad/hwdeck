            short = ("GPU FAN" if name.startswith("GPU") else f"FAN {num.group(1) if num else '?'}")
            lamp(s, x, fy, wid, short, l_, blink, lit_bg="c")
            lamp(s, x, fy + 1, wid, f"{rpm:04.0f} RPM", l_, blink, lit_bg="c")
            if p:
                hbar(s, x, fy + 2, wid - 5, p[2], "C")
                s.put(x + wid - 4, fy + 2, f"{p[2] * 100:3.0f}%", INK2)
                mode = {"0": "OFF", "1": "MAN", "2": "THRM", "5": "AUTO"}.get(p[3] or "", p[3] or "")
                s.put(x, fy + 3, f"PWM {mode}"[:wid], DIM)
            x += wid + 1
    ty = fy + 4
    # temperature traces fill the rest of the band
    halfw = (w - 1) // 2
    s.put(0, ty, "CPU PKG TEMP", DIM)
    trace(s, 13, ty, halfw - 13, 2, pn.hist["cpu_t"], 20, 100, "Y")
    s.put(halfw + 1, ty, "GPU JNC TEMP", DIM)
    trace(s, halfw + 14, ty, w - halfw - 14, 2, pn.hist["gpu_t"], 20, 110, "Y")

    # ================================================================ POWER =========
    y = ty + 2
    header(s, 0, y, w, "power // electrical", f"{len(volts):02d} RAIL")
    vitems = []
    for grp, name, v in volts:
        key = f"{grp}{name}"
        avg = pn.vavg.get(key, v)
