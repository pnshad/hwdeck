        by += 1
    if not evs and by < h - 1:
        s.put(x2, by, f"{time.strftime('%H:%M:%S')} NO EVENTS", "g")
    # ---- last row: event log ticker ------------------------------------------------------
    ev = list(pn.log)
    line = "   ".join(f"{t} {txt}" for t, txt, _ in ev[-3:]) or f"{time.strftime('%H:%M:%S')} ALL SYSTEMS NOMINAL"
    extra = "   ".join(st["extra"])
    s.put(0, h - 1, " " * w, "k", "K")
    s.put(0, h - 1, f" EVT  {line}"[: w - len(extra) - 2], "k", "K")
    if extra:
        s.put(w - len(extra) - 1, h - 1, ascii_only(extra).upper(), "k", "K")

def lab_short(label):
    return (label.replace("package", "PKG").replace("junction", "JNC").replace("composite", "")
            .replace("chipset", "PCH").replace("system", "SYS").replace("socket", "SKT")
            .replace("DIMM ", "D").replace("core ", "C").replace("edge", "EDG").replace("mem", "MEM")
            .replace("PCH_CHIP_TEMP", "PCH").replace("PCH_CHIP_CPU_MAX_TEMP", "PCHMX")
            .replace("PCH_CPU_TEMP", "PCHCPU").replace("PCH_MCH_TEMP", "MCH").replace("AUXTIN", "AUX"))

# ============================================================== equalizer ====
# The default style: groups of spectrum-analyzer bars, like an old media player's
# visualizer. Segmented bars (one ▄ per cell, so rows show as separate LEDs), a
# green -> yellow -> red gradient by height, and a white peak-hold cap that waits a
# moment and then falls. Voltage rails are EQ sliders: a knob on a track, centred on
# the rail's own running average. Text is kept to box titles and one figure per box.

EQ_COLORS = ((0.40, "g"), (0.60, "G"), (0.75, "Y"), (0.90, "y"), (1.01, "R"))

def eq_color(pos):
    for limit, c in EQ_COLORS:
        if pos <= limit:
            return c
    return "R"

class Peaks:
    """Peak hold per bar: stays 3 refreshes, then drops one segment per refresh."""
    def __init__(self):
        self.p = {}

    def update(self, key, lit):
        peak, hold = self.p.get(key, (0, 0))
        if lit >= peak:
            peak, hold = lit, 3
        elif hold > 0:
            hold -= 1
        else:
            peak = max(lit, peak - 1)
        self.p[key] = (peak, hold)
        return peak

def eqbar(s, x, y, h, w, frac, peaks=None, key=None, color=None):
    """One analyzer bar, bottom at y+h-1. Unlit segments are faint so the grid is always visible."""
    frac = max(0.0, min(1.0, frac))
    lit = round(frac * h)
    if frac > 0.01 and lit == 0:
        lit = 1
    peak = peaks.update(key, lit) if peaks is not None else 0
    for r in range(h):
        yy = y + h - 1 - r
        if r < lit:
            s.put(x, yy, "▄" * w, color or eq_color((r + 1) / h))
        elif peak > lit and r == peak - 1:
            s.put(x, yy, "▄" * w, "W")                      # peak-hold cap
        else:
            s.put(x, yy, " " * w, "k")
    return lit

def eqbox(s, x, y, w, h, title, figure="", fig_c="W"):
    s.put(x, y, "┌" + "─" * (w - 2) + "┐", DIM)
    for i in range(1, h - 1):
        s.put(x, y + i, "│", DIM)
        s.put(x + w - 1, y + i, "│", DIM)
    s.put(x, y + h - 1, "└" + "─" * (w - 2) + "┘", DIM)
    s.put(x + 2, y, f" {title.upper()} ", ACCENT)
    if figure:
        s.put(x + w - 3 - len(figure), y, f" {figure} ", fig_c)

def eqgroup(s, x, y, w, h, fracs, peaks, prefix, colors=None, labels=None):
    """Bars spread evenly over w cells: bar width 1-3, one-cell gaps."""
    n = len(fracs)
    if n == 0:
        return
    bw = max(1, min(3, (w + 1) // n - 1))
    step = bw + 1
    used = n * step - 1
    x0 = x + max(0, (w - used) // 2)
    bh = h - (1 if labels else 0)
    for i, f in enumerate(fracs):
        if x0 + i * step + bw > x + w:
            break
        eqbar(s, x0 + i * step, y, bh, bw, f, peaks, f"{prefix}{i}", colors[i] if colors else None)
        if labels and labels[i]:
            s.put(x0 + i * step, y + bh, labels[i][:bw], DIM)

def history_bars(s, x, y, w, h, data, lo, hi):
    """Scrolling analyzer: one 1-cell bar per sample, newest on the right."""
    vals = list(data)[-w:]
    pad = w - len(vals)
    for i in range(w):
        v = vals[i - pad] if i >= pad else lo
        f = 0.0 if hi <= lo else max(0.0, min(1.0, (v - lo) / (hi - lo)))
        lit = round(f * h)
        if f > 0.01 and lit == 0:
            lit = 1
        for r in range(h):
            s.put(x + i, y + h - 1 - r, "▄" if r < lit else " ", eq_color((r + 1) / h) if r < lit else "k")

def slider(s, x, y, h, dev, span=0.06):
    """EQ slider: a track with a knob, centre = the rail's running average, full scale = ±span."""
    mid = h // 2
    pos = mid - round(max(-1.0, min(1.0, dev / span)) * mid)
    for r in range(h):
        s.put(x, y + r, "┼" if r == mid else "│", DIM)
    c = "G" if abs(dev) < 0.03 else ("Y" if abs(dev) < 0.08 else "R")
    s.put(x - 1, y + pos, "▐█▌", c)

def logf(v, lo=1.0, hi=1e8):
    """Log scale so a trickle still moves: lo -> 0, hi -> 1."""
    import math
    if v <= lo:
        return 0.0
    return min(1.0, math.log10(v / lo) / math.log10(hi / lo))

def rail_scale(v):
    """Full scale for a voltage bar: the next standard rail above it."""
    for top in (1.5, 2.0, 4.0, 6.0, 14.0):
        if v < top * 0.92:
            return top
    return v * 1.2

class Counters:
    """Rates from /proc/stat and /proc/net/dev between refreshes."""
    def __init__(self):
        self.prev, self.t = None, None

    def sample(self):
        now = time.time()
        cur = {}
        for line in (read("/proc/stat", "") or "").splitlines():
            f = line.split()
            if f and f[0] == "cpu":
                cur["cpu"] = list(map(int, f[1:9]))
            elif f and f[0] in ("ctxt", "intr"):
                cur[f[0]] = int(f[1])
            elif f and f[0] == "procs_running":
                cur["running"] = int(f[1])
        for line in (read("/proc/net/dev", "") or "").splitlines()[2:]:
            name, rest = line.split(":", 1)
            f = rest.split()
            cur["net:" + name.strip()] = (int(f[0]), int(f[1]), int(f[8]), int(f[9]))
        out = {"running": cur.get("running", 0)}
        if self.prev:
            dt = max(now - self.t, 1e-3)
            a, b = self.prev["cpu"], cur["cpu"]
            tot = max(sum(b) - sum(a), 1)
            names = ["user", "nice", "system", "idle", "iowait", "irq", "softirq", "steal"]
            out["cpu"] = {n: (b[i] - a[i]) / tot for i, n in enumerate(names)}
            out["ctxt"] = (cur["ctxt"] - self.prev["ctxt"]) / dt
            out["intr"] = (cur["intr"] - self.prev["intr"]) / dt
            out["net"] = {}
            for k, v in cur.items():
                if k.startswith("net:") and k in self.prev:
                    p = self.prev[k]
                    out["net"][k[4:]] = tuple((v[i] - p[i]) / dt for i in range(4))
        self.prev, self.t = cur, now
        return out

def draw_eq(s, st, cfg, pn):
    w, h = s.w, s.h
    peaks = pn.peaks
    temps_all = [t for t in st["temps"] if not re.match(r"^(PECI|Sensor \d)", t[1]) and t[2] > 0.5]
    g, m = st["gpu"], st["mem"]
    cores = st["cores"]
    gtemp, gpow, gcap = g.get("temp"), g.get("power"), g.get("power_cap") or 0
    root = next((d for d in st["disks"] if d[0] == "/"), st["disks"][0] if st["disks"] else None)
    volts, powers, pwms, intr = all_channels(cfg)
    pn.hist["gpw"].append(gpow or 0)
    k = pn.counters.sample()

    # ---- top line: name, clock, services as dots --------------------------------------
    s.put(1, 0, (cfg.get("title") or st["host"]).upper(), ACCENT)
    clock = time.strftime("%H:%M:%S")
    s.put(w - 1 - len(clock), 0, clock, INK2)
    sx = 2 + len(cfg.get("title") or st["host"]) + 2
    for u, stt in st["services"]:
        s.put(sx, 0, "■", "G" if stt == "active" else "R")
        sx += 2
    if st["extra"]:
        e = ascii_only(st["extra"][0]).upper()
        s.put((w - len(e)) // 2, 0, e, DIM)

    # ---- band 1: CPU cores | GPU | memory ----------------------------------------------
    y, bh = 1, 17
    cw = 2 + len(cores) * 3 + 1
    cw = max(cw, 30)
    gw = 2 + 7 * 4 + 1
    mw = 2 + 4 * 4 + 1
    nw = w - cw - gw - mw
    eqbox(s, 0, y, cw, bh, "cpu", f"{st['cpu']:.0f}%", heat(st["cpu"] / 100))
    eqgroup(s, 2, y + 1, cw - 4, bh - 2, [c / 100 for c in cores], peaks, "core",
            labels=[f"{i:02d}" for i in range(len(cores))])
    x = cw
    busy = g.get("busy", 0)
    eqbox(s, x, y, gw, bh, "gpu", f"{busy:.0f}%", heat(busy / 100))
    if st.get("gpu_kind"):
        gf = [busy / 100,
              (g["vram_used"] / g["vram_total"]) if g.get("vram_total") else 0,
              (gpow / gcap) if gpow is not None and gcap else 0,
              ((gtemp - 20) / 90) if gtemp is not None else 0,
              min(1.0, (g.get("fan") or 0) / 3000) if g.get("fan") is not None else (g.get("fan_pct") or 0) / 100,
              (g.get("sclk") or 0) / (g.get("sclk_max") or 1),
              (g.get("mclk") or 0) / (g.get("mclk_max") or 1)]
        eqgroup(s, x + 2, y + 1, gw - 4, bh - 2, gf, peaks, "gpu",
                labels=["BS", "VR", "PW", "TM", "FN", "CK", "MK"])
    x += gw
    mf = m["used"] / m["total"]
    eqbox(s, x, y, mw, bh, "mem", f"{m['used'] / 2**30:.1f}G", heat(mf))
    eqgroup(s, x + 2, y + 1, mw - 4, bh - 2,
            [mf, m["cached"] / m["total"], (m["swap_used"] / m["swap_total"]) if m["swap_total"] else 0,
             (root[1] / root[2]) if root else 0], peaks, "mem", labels=["US", "CA", "SW", "DK"])
    x += mw
    _, rx, tx = st["net"]
    eqbox(s, x, y, nw, bh, "net", f"{human(rx)}/s", "C")
    nets = {n: v for n, v in k.get("net", {}).items() if n != "lo" and not n.startswith(("veth", "docker", "br-"))}
    nf, nl = [], []
    for n, (brx, prx, btx, ptx) in sorted(nets.items(), key=lambda kv: -sum(kv[1]))[:4]:
        nf += [logf(brx, 10, 1e8), logf(btx, 10, 1e8), logf(prx, 1, 1e5), logf(ptx, 1, 1e5)]
        tag = n[:1].upper()
        nl += [tag + "R", tag + "T", "pr", "pt"]
    eqgroup(s, x + 1, y + 1, nw - 2, bh - 2, nf, peaks, "net", labels=nl)

    # ---- band 2: temperatures | fans ----------------------------------------------------
    y, bh = y + 17, 15
    fans = st["fans"]
    board_pwm = {p[1]: p for p in pwms if p[0] == "Board"}
    gpu_pwm = next((p for p in pwms if p[0] == "GPU"), None)
    fw = 2 + len(fans) * 5 + 1
    tw = w - fw
    hottest = max((t[2] for t in temps_all), default=0)
    eqbox(s, 0, y, tw, bh, "temp", f"{hottest:.0f}°C", heat((hottest - 20) / 80))
    order = sorted(temps_all, key=lambda t: (GROUP_ORDER.index(t[0]) if t[0] in GROUP_ORDER else 99))
    tf = [(t[2] - 20) / (((t[3] or 100) if (t[3] or 100) < 130 else 100) - 20) for t in order]
    groups_lab, last = [], None
    for t in order:
        lab_ = {"Board": "BD", "NVMe": "SS", "Wi-Fi": "WF", "ACPI": "AC"}.get(t[0], t[0][:2]) if t[0] != last else ""
        groups_lab.append(lab_)
        last = t[0]
    eqgroup(s, 2, y + 1, tw - 4, bh - 2, tf, peaks, "temp", labels=groups_lab)
    x = tw
    rpm_top = max([f[1] for f in fans] + [2000])
    eqbox(s, x, y, fw, bh, "fans", f"{sum(1 for f in fans if f[1] > 0)}/{len(fans)}", "C")
    for i, (name, rpm) in enumerate(fans):
        fx = x + 2 + i * 5
        num = re.search(r"(\d+)$", name)
        p = gpu_pwm if name.startswith("GPU") else (board_pwm.get(int(num.group(1))) if num else None)
        eqbar(s, fx, y + 1, bh - 3, 2, rpm / rpm_top, peaks, f"fan{i}", "C")
        eqbar(s, fx + 2, y + 1, bh - 3, 1, p[2] if p else 0, None, None, "B")
        s.put(fx, y + bh - 2, ("GP" if name.startswith("GPU") else f"F{num.group(1) if num else '?'}"), DIM)

    # ---- band 3: load history | power | voltage rails -----------------------------------
    y = y + bh
    bh = h - y
    vw = 2 + len(volts) * 3 + 1 if volts else 0
    pw = 2 + 6 * 4 + 1
    lw = w - vw - pw
    ct = k.get("cpu", {})
    nc = max(len(cores), 1)
    lf = [ct.get("user", 0), ct.get("system", 0), ct.get("iowait", 0), ct.get("irq", 0) + ct.get("softirq", 0),
          ct.get("nice", 0), st["load"][0] / nc, st["load"][1] / nc, st["load"][2] / nc,
          min(1.0, k.get("running", 0) / nc), logf(k.get("ctxt", 0), 100, 1e6), logf(k.get("intr", 0), 100, 1e6)]
    eqbox(s, 0, y, lw, bh, "load", f"{st['load'][0]:.2f}", heat(st["load"][0] / nc))
    eqgroup(s, 1, y + 1, lw - 2, bh - 2, lf, peaks, "load",
            labels=["us", "sy", "io", "ir", "ni", "l1", "l5", "lf", "rn", "cs", "in"])
    x = lw
    gv = next((v for grp, name, v in volts if grp == "GPU"), None)
    fq_all = core_freqs(len(cores))
    fmax = max((mx for _, mx in fq_all), default=0)
    favg = sum(c for c, _ in fq_all) / len(fq_all) if fq_all else 0
    duty = [p[2] for p in pwms if p[3] not in ("0", None)]
    pf = [(gpow / gcap) if gpow is not None and gcap else 0, ((gv or 0.7) - 0.7) / 0.5,
          (g.get("sclk") or 0) / (g.get("sclk_max") or 1), (g.get("mclk") or 0) / (g.get("mclk_max") or 1),
          favg / fmax if fmax else 0, sum(duty) / len(duty) if duty else 0]
    eqbox(s, x, y, pw, bh, "power", f"{gpow or 0:.0f}W" if gpow is not None else "", heat((gpow or 0) / (gcap or 1)))
    eqgroup(s, x + 1, y + 1, pw - 2, bh - 2, pf, peaks, "pow", labels=["GW", "GV", "GC", "GM", "CC", "FD"])
    if vw:
        x += pw
        vc = next((v for grp, name, v in volts if name == "VCORE"), None)
        eqbox(s, x, y, w - x, bh, "rails", f"{vc:.2f}V" if vc else f"{len(volts)}", "W")
        rf = [v / rail_scale(pn.vtop.setdefault(f"{grp}{name}", v)) for grp, name, v in volts]
        rl = [{"VCORE": "VC", "VDDGFX": "GV", "AVCC": "AV", "3VCC": "33", "3VSB": "SB", "VBAT": "BT"}.get(name, name[-2:])
              for grp, name, v in volts]
        eqgroup(s, x + 1, y + 1, w - x - 2, bh - 2, rf, peaks, "rail", labels=rl)

# ================================================================= bunker ====
# The default style: one heavy chassis of analyzer meters, read top to bottom
# (A usage, B thermal + cooling, C power). Every LED position is always drawn, dark
# when unlit, the way real panel meters look. Colour roles: g lit, y upper range and
# readouts, R top segments and alarm, K unlit and walls, W peak caps. One loud element:
# the hazard-striped master plate.

def b_color(pos):
    return "g" if pos <= 0.60 else ("y" if pos <= 0.85 else "R")

def bbar(s, x, y, h, w, frac, peaks=None, key=None, color=None):
    frac = max(0.0, min(1.0, frac))
    lit = round(frac * h)
    if frac > 0.01 and lit == 0:
        lit = 1
    peak = peaks.update(key, lit) if peaks is not None else 0
    for r in range(h):
        yy = y + h - 1 - r
        if r < lit:
            c = color or b_color((r + 1) / h)
        elif peak > lit and r == peak - 1:
            c = "W"
        else:
            c = "K"
        s.put(x, yy, "▄" * w, c)

def bgroup(s, x, y, w, h, fracs, peaks, prefix, labels=None, colors=None, widths=None):
    """Bars spread over w cells, floor labels on the last row."""
    n = len(fracs)
    if not n:
        return
    bw = widths or max(1, min(3, (w + 1) // n - 1))
    step = bw + 1
    x0 = x + max(0, (w - (n * step - 1)) // 2)
    for i, f in enumerate(fracs):
        bx = x0 + i * step
        if bx + bw > x + w:
            break
        bbar(s, bx, y, h - 1, bw, f, peaks, f"{prefix}{i}", colors[i] if colors else None)
        if labels and labels[i]:
            s.put(bx, y + h - 1, labels[i][: bw + (1 if bw < 3 else 0)], "y")

def scale_rail(s, x, y, h, top="100", mid=" 50", bot="  0"):
    """Tick rail on the left of a meter zone: labels plus ┤ ticks, floor row left blank."""
    hh = h - 1
    for r in range(hh):
        s.put(x + 3, y + r, "┤" if r in (0, hh // 2, hh - 1) else "│", "K")
    s.put(x, y, top[-3:].rjust(3), "K")
    s.put(x, y + hh // 2, mid[-3:].rjust(3), "K")
    s.put(x, y + hh - 1, bot[-3:].rjust(3), "K")

def tag(s, x, y, code, name, dro="", dro_c="y", right=None):
    """Stencil tag in a wall: ╡ A1 · CPU ╞, and a digital readout at the right end."""
    if dro and right is not None:
        room = right - x - len(dro) - 4 - (len(code) + 7)
        name = name[: max(0, room)]
    s.put(x, y, "╡ ", "K")
    s.put(x + 2, y, code, "y")
    if name:
        s.put(x + 2 + len(code), y, " · ", "K")
        s.put(x + 5 + len(code), y, name.upper(), "W")
        s.put(x + 5 + len(code) + len(name), y, " ╞", "K")
    else:
        s.put(x + 2 + len(code), y, " ╞", "K")
    if dro and right is not None:
        d = f"╡ {dro} ╞"
        s.put(right - len(d), y, "╡ ", "K")
        s.put(right - len(d) + 2, y, dro, dro_c)
        s.put(right - 2, y, " ╞", "K")

def chassis(s, w, h, bands):
    """bands: [(top_row, bottom_row, [wall x positions incl. 0 and w-1])]. Draws one rack."""
    top, bottom = bands[0][0], bands[-1][1]
    s.put(0, top, "╔" + "═" * (w - 2) + "╗", "K")
    s.put(0, bottom, "╚" + "═" * (w - 2) + "╝", "K")
    for r in range(top + 1, bottom):
        s.put(0, r, "║", "K")
        s.put(w - 1, r, "║", "K")
    for i, (t, b, walls) in enumerate(bands):
        if i > 0:
            s.put(0, t, "╟" + "─" * (w - 2) + "╢", "K")
        for x in walls[1:-1]:
            for r in range(t + 1, b):
                s.put(x, r, "│", "K")
    for i, (t, b, walls) in enumerate(bands):
        inner = walls[1:-1]
        above = bands[i - 1][2][1:-1] if i > 0 else []
        for x in set(inner) | set(above):
            if i == 0:
                s.put(x, t, "╤", "K")
            else:
                ch = "┼" if (x in inner and x in above) else ("┬" if x in inner else "┴")
                s.put(x, t, ch, "K")
    for x in bands[-1][2][1:-1]:
        s.put(x, bottom, "╧", "K")

def master_plate(s, x, y, w, worst, blink):
    if worst >= 4:
        bg, word = ("R" if blink else "r"), "MASTER ALARM"
    elif worst == 3:
        bg, word = "y", "MASTER CAUTION"
    else:
        bg, word = "K", "MASTER CLEAR"
    text = f" {word} "
    side = (w - len(text)) // 2
    stripes = "/" * side
    s.put(x, y, (stripes + text + "/" * (w - side - len(text)))[:w], "k", bg)

def draw_bunker(s, st, cfg, pn):
    w, h = s.w, s.h
    pn.tick += 1
    blink = pn.tick % 2 == 0
    peaks = pn.peaks
    temps_all = [t for t in st["temps"] if not re.match(r"^(PECI|Sensor \d)", t[1]) and t[2] > 0.5]
    temps = rank(st["temps"], cfg.get("hide_sensors", []))
    g, m = st["gpu"], st["mem"]
    cores = st["cores"]
    gtemp, gpow, gcap = g.get("temp"), g.get("power"), g.get("power_cap") or 0
    root = next((d for d in st["disks"] if d[0] == "/"), st["disks"][0] if st["disks"] else None)
    volts, powers, pwms, intr = all_channels(cfg)
    k = pn.counters.sample()
    cpu_t = next((t for t in temps if t[0] == "CPU"), None)

    # ---- state for the master plate and the event log ---------------------------------
    lv = {"CPU LOAD": level_load(st["cpu"] / 100),
          "CPU TEMP": level_temp(cpu_t[2], cpu_t[3]) if cpu_t else 0,
          "GPU LOAD": level_load(g.get("busy", 0) / 100) if st.get("gpu_kind") else 0,
          "GPU TEMP": level_temp(gtemp, 110) if gtemp is not None else 0,
          "GPU POWER": level_load(gpow / gcap) if gpow is not None and gcap else 0,
          "MEMORY": level_load(m["used"] / m["total"]),
          "DISK": level_load(root[1] / root[2]) if root else 0,
          "HOT SPOT": max((level_temp(t[2], t[3]) for t in temps), default=0)}
    down = [u for u, stt in st["services"] if stt != "active"]
    lv["SERVICES"] = 4 if down else 0
    for key, v in lv.items():
        pn.note(key, v)
    worst = max(lv.values(), default=0)

    # ---- row 0: title plate + hazard master plate -------------------------------------
    s.put(0, 0, " " * w, "y", "K")
    unit = (cfg.get("title") or st["host"]).upper()
    s.put(1, 0, "HWDECK", "W", "K")
    s.put(8, 0, f"─ UNIT {unit} ─ PLANT MONITOR", "y", "K")
    up = st["uptime"]
    clock = f"T+{int(up // 86400):03d}D{int(up % 86400 // 3600):02d}H   {time.strftime('%H:%M:%S')}"
    mp_w = 22
    s.put(w - mp_w - 2 - len(clock), 0, clock, "W", "K")
    master_plate(s, w - mp_w - 1, 0, mp_w, worst, blink)

    # ---- chassis ----------------------------------------------------------------------
    A = (1, 17, [0, 41, 72, 92, w - 1])
    B = (17, 32, [0, 90, w - 1])
    C = (32, h - 2, [0, 40, 67, w - 1])
    chassis(s, w, h, [A, B, C])

    def zone(band, i):
        t, b, walls = band
        x0, x1 = walls[i], walls[i + 1]
        return x0, x1, t + 1, b - t - 1          # wall x, next wall x, first interior row, interior rows

    # A1 CPU
    x0, x1, zy, zh = zone(A, 0)
    tag(s, x0 + 2, A[0], "A1", "cpu", f"{st['cpu']:05.1f}%", "y", x1 - 1)
    scale_rail(s, x0 + 1, zy, zh)
    bgroup(s, x0 + 5, zy, x1 - x0 - 5, zh, [c / 100 for c in cores], peaks, "core",
           labels=[f"{i:02d}" for i in range(len(cores))])
    # A2 GPU
    x0, x1, zy, zh = zone(A, 1)
    busy = g.get("busy", 0)
    tag(s, x0 + 2, A[0], "A2", "gpu", f"{busy:05.1f}%", "y", x1 - 1)
    scale_rail(s, x0 + 1, zy, zh)
    if st.get("gpu_kind"):
        gf = [busy / 100, (g["vram_used"] / g["vram_total"]) if g.get("vram_total") else 0,
              (gpow / gcap) if gpow is not None and gcap else 0, ((gtemp - 20) / 90) if gtemp is not None else 0,
              min(1.0, (g.get("fan") or 0) / 3000), (g.get("sclk") or 0) / (g.get("sclk_max") or 1),
              (g.get("mclk") or 0) / (g.get("mclk_max") or 1)]
        bgroup(s, x0 + 5, zy, x1 - x0 - 5, zh, gf, peaks, "gpu", labels=["BS", "VR", "PW", "TM", "FN", "CK", "MK"])
    # A3 MEM
    x0, x1, zy, zh = zone(A, 2)
    tag(s, x0 + 2, A[0], "A3", "mem", f"{m['used'] / 2**30:04.1f}G", "y", x1 - 1)
    bgroup(s, x0 + 1, zy, x1 - x0 - 2, zh,
           [m["used"] / m["total"], m["cached"] / m["total"],
            (m["swap_used"] / m["swap_total"]) if m["swap_total"] else 0, (root[1] / root[2]) if root else 0],
           peaks, "mem", labels=["US", "CA", "SW", "DK"])
    # A4 NET
    x0, x1, zy, zh = zone(A, 3)
    _, rx, tx = st["net"]
    tag(s, x0 + 2, A[0], "A4", "net", f"{rx / 1024:06.1f}K", "y", x1 - 1)
    scale_rail(s, x0 + 1, zy, zh, "1G", "10K", " 0")
    nets = {n: v for n, v in k.get("net", {}).items() if n != "lo" and not n.startswith(("veth", "docker", "br-"))}
    nf, nl = [], []
    for n, (brx, prx, btx, ptx) in sorted(nets.items(), key=lambda kv: kv[0])[:5]:
        code = {"w": "WL", "e": "EN", "t": "TS"}.get(n[0], n[:2].upper())
        nf += [logf(brx, 10, 1e8), logf(btx, 10, 1e8)]
        nl += [code[:1] + "▼", code[:1] + "▲"]
    bgroup(s, x0 + 5, zy, x1 - x0 - 5, zh, nf, peaks, "net", labels=nl)

    # B1 THERMAL
    x0, x1, zy, zh = zone(B, 0)
    hottest = max((t[2] for t in temps_all), default=0)
    tag(s, x0 + 2, B[0], "B1", "thermal", f"{hottest:05.1f}°C", "R" if lv["HOT SPOT"] >= 3 else "y", x1 - 1)
    scale_rail(s, x0 + 1, zy, zh, "100", " 60", " 20")
    order = sorted(temps_all, key=lambda t: (GROUP_ORDER.index(t[0]) if t[0] in GROUP_ORDER else 99))
    tf = [(t[2] - 20) / (((t[3] or 100) if (t[3] or 100) < 130 else 100) - 20) for t in order]
    tl, last = [], None
    for t in order:
        tl.append({"Board": "BD", "NVMe": "SS", "Wi-Fi": "WF", "ACPI": "AC", "NIC": "NI"}.get(t[0], t[0][:2]).upper()
                  if t[0] != last else "")
        last = t[0]
    bgroup(s, x0 + 5, zy, x1 - x0 - 5, zh, tf, peaks, "temp", labels=tl)
    # B2 COOLING
    x0, x1, zy, zh = zone(B, 1)
    fans = st["fans"]
    spinning = sum(1 for f in fans if f[1] > 0)
    tag(s, x0 + 2, B[0], "B2", "cooling", f"{spinning}/{len(fans)}", "y", x1 - 1)
    scale_rail(s, x0 + 1, zy, zh, "3K", "1.5", " 0")
    board_pwm = {p[1]: p for p in pwms if p[0] == "Board"}
    gpu_pwm = next((p for p in pwms if p[0] == "GPU"), None)
    fx = x0 + 6
    fstep = max(4, (x1 - x0 - 6) // max(len(fans), 1))
    for i, (name, rpm) in enumerate(fans):
        if fx + 3 > x1:
            break
        num = re.search(r"(\d+)$", name)
        p = gpu_pwm if name.startswith("GPU") else (board_pwm.get(int(num.group(1))) if num else None)
        bbar(s, fx, zy, zh - 1, 2, rpm / 3000, peaks, f"fan{i}")
        bbar(s, fx + 2, zy, zh - 1, 1, p[2] if p else 0, None, None, "y")
        s.put(fx, zy + zh - 1, "GP" if name.startswith("GPU") else f"F{num.group(1) if num else '?'}", "y")
        fx += fstep

    # C1 LOAD
    x0, x1, zy, zh = zone(C, 0)
    ct = k.get("cpu", {})
    nc = max(len(cores), 1)
    tag(s, x0 + 2, C[0], "C1", "load", f"{st['load'][0]:05.2f}", "y", x1 - 1)
    scale_rail(s, x0 + 1, zy, zh)
    bgroup(s, x0 + 5, zy, x1 - x0 - 5, zh,
           [ct.get("user", 0), ct.get("system", 0), ct.get("iowait", 0), ct.get("irq", 0) + ct.get("softirq", 0),
            ct.get("nice", 0), st["load"][0] / nc, st["load"][1] / nc, st["load"][2] / nc,
            min(1.0, k.get("running", 0) / nc), logf(k.get("ctxt", 0), 100, 1e6), logf(k.get("intr", 0), 100, 1e6)],
           peaks, "load", labels=["US", "SY", "IO", "IR", "NI", "L1", "L5", "LF", "RN", "CS", "IN"])
    # C2 POWER
    x0, x1, zy, zh = zone(C, 1)
    gv = next((v for grp, name, v in volts if grp == "GPU"), None)
    fq = core_freqs(len(cores))
    fmax = max((mx for _, mx in fq), default=0)
    favg = sum(c for c, _ in fq) / len(fq) if fq else 0
    duty = [p[2] for p in pwms if p[3] not in ("0", None)]
    tag(s, x0 + 2, C[0], "C2", "power", f"{gpow or 0:05.1f}W", "y", x1 - 1)
    bgroup(s, x0 + 1, zy, x1 - x0 - 2, zh,
           [(gpow / gcap) if gpow is not None and gcap else 0, ((gv or 0.7) - 0.7) / 0.5,
            (g.get("sclk") or 0) / (g.get("sclk_max") or 1), (g.get("mclk") or 0) / (g.get("mclk_max") or 1),
            favg / fmax if fmax else 0, sum(duty) / len(duty) if duty else 0],
           peaks, "pow", labels=["GW", "GV", "GC", "GM", "CC", "FD"])
    # C3 RAILS
    x0, x1, zy, zh = zone(C, 2)
    vc = next((v for grp, name, v in volts if name == "VCORE"), None)
    tag(s, x0 + 2, C[0], "C3", "rails", f"{vc:05.3f}V" if vc else "-----", "y", x1 - 1)
    scale_rail(s, x0 + 1, zy, zh, "MAX", "1/2", "  0")
    rf = [v / rail_scale(pn.vtop.setdefault(f"{grp}{name}", v)) for grp, name, v in volts]
    rl = [{"VCORE": "VC", "VDDGFX": "GV", "AVCC": "AV", "3VCC": "33", "3VSB": "SB", "VBAT": "BT"}.get(name, name[-2:])
          for grp, name, v in volts]
    bgroup(s, x0 + 5, zy, x1 - x0 - 5, zh, rf, peaks, "rail", labels=rl)

    # ---- row 47: status strip ----------------------------------------------------------
    y = h - 1
    s.put(0, y, " " * w, "K", "K")
    x = 1
    for u, stt in st["services"]:
        name = ascii_only(u).upper()
        s.put(x, y, "▐", "g" if stt == "active" else "R", "K")
        s.put(x + 1, y, name, "k", "g" if stt == "active" else ("R" if blink else "r"))
        s.put(x + 1 + len(name), y, "▌", "g" if stt == "active" else "R", "K")
        x += len(name) + 3
    ev = list(pn.log)
    last = f"{ev[-1][0]} {ev[-1][1]}" if ev else "ALL SYSTEMS NOMINAL"
    extra = ascii_only(st["extra"][0]).upper() if st["extra"] else ""
    room = w - x - 1
    right = f"{extra} │ {last}" if extra else last
    if len(right) > room:
        right = extra if extra and len(extra) <= room else right[:room]
    s.put(w - 1 - len(right), y, right, "y", "K")

# =================================================================== btop ====
# The same fields in btop's design language: a coloured border per box with its title
# (and a red hotkey digit) set into the top edge, gradient graphs, ■ meters with a dim
# remainder, dense per-core rows, small grey labels, clock centred in the top border.
# 16-colour mapping of btop's default theme: cpu green, mem olive, net purple,
# gpu cyan, thermal red, power yellow.

BT = {"cpu": "g", "mem": "y", "net": "m", "gpu": "c", "temp": "r", "cool": "b", "power": "y", "sys": "K"}

def bt_grad(frac):
    return "G" if frac < 0.50 else ("Y" if frac < 0.75 else ("y" if frac < 0.90 else "R"))

def bt_box(s, x, y, w, h, num, title, color, centre=None, right=None):
    s.put(x, y, "┌" + "─" * (w - 2) + "┐", color)
    for i in range(1, h - 1):
        s.put(x, y + i, "│", color)
        s.put(x + w - 1, y + i, "│", color)
    s.put(x, y + h - 1, "└" + "─" * (w - 2) + "┘", color)
    s.put(x + 2, y, "┐", color)
    s.put(x + 3, y, str(num), "R")
    s.put(x + 3 + len(str(num)), y, title, "W")
    s.put(x + 3 + len(str(num)) + len(title), y, "┌", color)
    if centre:
        cx = x + (w - len(centre) - 2) // 2
        s.put(cx, y, "┐", color); s.put(cx + 1, y, centre, "W"); s.put(cx + 1 + len(centre), y, "┌", color)
    if right:
        rx = x + w - len(right) - 4
        s.put(rx, y, "┐", color); s.put(rx + 1, y, right, "w"); s.put(rx + 1 + len(right), y, "┌", color)

def bt_meter(s, x, y, w, frac, color=None):
    frac = max(0.0, min(1.0, frac))
    n = round(frac * w)
    for i in range(w):
        if i < n:
            s.put(x + i, y, "■", color or bt_grad((i + 1) / w))
        else:
            s.put(x + i, y, "■", "K")

def bt_graph(s, x, y, w, h, data, lo, hi, grad=bt_grad, up=True):
    """Filled history graph, two levels per cell; colour by height like btop's gradients.
    up=False draws it hanging from the top (btop's mirrored upload graph)."""
    vals = list(data)[-w:]
    pad = w - len(vals)
    for i, v in enumerate(vals):
        f = 0.0 if hi <= lo else max(0.0, min(1.0, (v - lo) / (hi - lo)))
        units = round(f * h * 2)
        if units == 0 and v > lo:
            units = 1
        for r in range(h):
            need = units - r * 2
            if need <= 0:
                continue
            yy = (y + h - 1 - r) if up else (y + r)
            ch = "█" if need >= 2 else ("▄" if up else "▀")
            s.put(x + pad + i, yy, ch, grad((r + 1) / h))

def core_ids(n):
    ids = []
    for i in range(n):
        c = read(f"/sys/devices/system/cpu/cpu{i}/topology/core_id")
        ids.append(int(c) if c and c.isdigit() else i)
    return ids

def draw_btop(s, st, cfg, pn):
    w, h = s.w, s.h
    pn.tick += 1
    temps_all = [t for t in st["temps"] if not re.match(r"^(PECI|Sensor \d)", t[1]) and t[2] > 0.5]
    temps = rank(st["temps"], cfg.get("hide_sensors", []))
    g, m = st["gpu"], st["mem"]
    cores = st["cores"]
    gtemp, gpow, gcap = g.get("temp"), g.get("power"), g.get("power_cap") or 0
    volts, powers, pwms, intr = all_channels(cfg)
    k = pn.counters.sample()
    pn.hist["gpw"].append(gpow or 0)
    cpu_t = next((t for t in temps if t[0] == "CPU"), None)
    core_temp = {}
    for grp, lab, t, crit in temps:
        mm = re.match(r"core (\d+)", lab)
        if grp == "CPU" and mm:
            core_temp[int(mm.group(1))] = t

    # spare rows beyond the 46-row minimum go to the cpu and gpu graphs first, not all to the bottom band
    spare = max(0, h - 46)
    ch = 15 + spare // 3
    wide = w - w // 2 >= 110                         # wide screen: every split sits mid-screen
    # ================================================================ 1 cpu =========
    host = (cfg.get("title") or st["host"])
    up = st["uptime"]
    bt_box(s, 0, 0, w, ch, 1, "cpu", BT["cpu"], centre=time.strftime("%H:%M:%S"),
           right=f"{host}  up {int(up // 86400)}d {int(up % 86400 // 3600):02d}:{int(up % 3600 // 60):02d}")
    pw_ = 56                                         # right panel: model + per-core rows
    gx, gw = 1, w - pw_ - 3
    bt_graph(s, gx, 1, gw, ch - 2, st["hist"]["cpu"], 0, 100)
    s.put(gx + 1, 1, f"{st['cpu']:.0f}%", "W")
    px = w - pw_ - 1
    bt_box(s, px, 1, pw_, ch - 2, "", ascii_only(st["cpu_model"])[: pw_ - 12], BT["cpu"])
    fq = core_freqs(len(cores))
    favg = sum(c for c, _ in fq) / len(fq) if fq else 0
    s.put(px + 2, 2, "CPU", "W")
    bt_meter(s, px + 6, 2, pw_ - 25, st["cpu"] / 100)
    s.put(px + pw_ - 18, 2, f"{st['cpu']:3.0f}%", "W")
    if cpu_t:
        s.put(px + pw_ - 13, 2, f"{cpu_t[2]:3.0f}°C", bt_grad((cpu_t[2] - 20) / 80))
    s.put(px + pw_ - 7, 2, f"{favg:.1f}G", "w")
    ids = core_ids(len(cores))
    rows = max(1, min(ch - 6, -(-len(cores) // 2)))
    colw = (pw_ - 3) // 2
    for i, v in enumerate(cores[: rows * 2]):
        cx = px + 2 + (i // rows) * (colw + 1)
        cy = 3 + i % rows
        s.put(cx, cy, f"C{i:<2}", "w")
        bt_meter(s, cx + 4, cy, colw - 16, v / 100)
        s.put(cx + colw - 11, cy, f"{v:3.0f}%", "W")
        t = core_temp.get(ids[i])
        if t is not None:
            s.put(cx + colw - 6, cy, f"{t:3.0f}°C", bt_grad((t - 20) / 80))
    ct = k.get("cpu", {})
    ly = ch - 3
    ey = 3 + rows
    if ey + 1 < ly:
        fmax = max((mx for _, mx in fq), default=0)
        s.put(px + 2, ey + 1, "CLK", "w")
        bt_meter(s, px + 6, ey + 1, pw_ - 25, favg / fmax if fmax else 0, "C")
        s.put(px + pw_ - 18, ey + 1, f"{favg:.2f} / {fmax:.1f} GHz", "W")
    if ey + 2 < ly:
        s.put(px + 2, ey + 2, f"ctx {human(k.get('ctxt', 0), '')}/s   irq {human(k.get('intr', 0), '')}/s   run {k.get('running', 0)}"
              f"   ni {ct.get('nice', 0) * 100:.0f}  si {ct.get('softirq', 0) * 100:.0f}", "w")
    s.put(px + 2, ly, "Load AVG:", "w")
    s.put(px + 12, ly, " ".join(f"{x:4.2f}" for x in st["load"]), "W")
    s.put(px + 30, ly, f"us {ct.get('user', 0) * 100:3.0f} sy {ct.get('system', 0) * 100:3.0f} io {ct.get('iowait', 0) * 100:3.0f}", "w")

    # ============================================================ 2 gpu | 3 mem ======
    y, bh = ch, 13 + spare // 3
    half = w // 2
    busy = g.get("busy", 0)
    bt_box(s, 0, y, half, bh, 2, "gpu", BT["gpu"], right=ascii_only(st["gpu_name"] or "no gpu")[: half - 12])
    if st.get("gpu_kind"):
        bt_graph(s, 1, y + 1, half - 2, bh - 7, st["hist"]["gpu"], 0, 100)
        s.put(2, y + 1, f"{busy:.0f}%", "W")
        rows_ = [("Busy", busy / 100, f"{busy:5.1f}%"),
                 ("VRAM", (g["vram_used"] / g["vram_total"]) if g.get("vram_total") else 0,
                  f"{(g.get('vram_used') or 0) / 2**30:4.1f}/{(g.get('vram_total') or 0) / 2**30:.0f}G"),
                 ("Power", (gpow / gcap) if gpow is not None and gcap else 0, f"{gpow or 0:4.0f}/{gcap:.0f}W"),
                 ("Temp", ((gtemp - 20) / 90) if gtemp is not None else 0, f"{gtemp or 0:5.0f}°C"),
                 ("Clock", (g.get("sclk") or 0) / (g.get("sclk_max") or 1), f"{g.get('sclk') or 0:4.0f}MHz")]
        for i, (name, f, val) in enumerate(rows_):
            yy = y + bh - 6 + i
            s.put(2, yy, name, "w")
            bt_meter(s, 9, yy, half - 23, f)
            s.put(half - 13, yy, val.rjust(11), "W")
    mx = half
    mw = w - half
    bt_box(s, mx, y, mw, bh, 3, "mem", BT["mem"], right=f"{m['total'] / 2**30:.1f} GiB")
    root = next((d for d in st["disks"] if d[0] == "/"), st["disks"][0] if st["disks"] else None)
    mrows = [("Used", m["used"], m["total"], None), ("Available", m["avail"], m["total"], "G"),
             ("Cached", m["cached"], m["total"], "C"), ("Swap", m["swap_used"], m["swap_total"] or 1, "M")]
    ndisk = min(len(st["disks"]), max(0, bh - 11))
    step = 2 + max(0, bh - 11 - ndisk) // 5          # spread spare rows between the meters
    for i, (name, v, tot, c) in enumerate(mrows):
        yy = y + 1 + i * step
        s.put(mx + 2, yy, f"{name}:", "w")
        s.put(mx + mw - 12, yy, human(v).rjust(9), "W")
        bt_meter(s, mx + 2, yy + 1, mw - 17, v / tot if tot else 0, c)
        s.put(mx + mw - 14, yy + 1, f"{v / tot * 100 if tot else 0:3.0f}%", "w")
    dy = y + 1 + 4 * step
    s.put(mx + 2, dy, "disks", "W")
    s.put(mx + 9, dy, f"io ▼{human(st['io'][0])}/s ▲{human(st['io'][1])}/s", "w")
    for i, (mnt, used, tot) in enumerate(st["disks"][:ndisk]):
        yy = dy + 1 + i
        s.put(mx + 2, yy, ascii_only(mnt)[:10].ljust(10), "w")
        bt_meter(s, mx + 13, yy, mw - 28, used / tot if tot else 0)
        s.put(mx + mw - 14, yy, f"{used / tot * 100 if tot else 0:3.0f}%  {human(tot)}".rjust(12), "W")

    # ======================================================== 4 temp | 5 cooling ====
    y, bh = y + bh, 11
    tw = max(84, half) if wide else 84
    hottest = max((t[2] for t in temps_all), default=0)
    bt_box(s, 0, y, tw, bh, 4, "temp", BT["temp"], right=f"hottest {hottest:.0f}°C  {len(temps_all)} sensors")
    order = sorted(temps_all, key=lambda t: (GROUP_ORDER.index(t[0]) if t[0] in GROUP_ORDER else 99))
    ncol = max(1, -(-len(order) // (bh - 2)))
    rows = max(1, -(-len(order) // ncol))            # even columns, not two full + one stub
    colw = (tw - 2) // ncol
    for i, (grp, lab, t, crit) in enumerate(order[: rows * ncol]):
        cx = 1 + (i // rows) * colw
        cy = y + 1 + i % rows
        crit = crit if crit and crit < 130 else 100
        f = (t - 20) / (crit - 20)
        gs = {"Board": "BRD", "NVMe": "NVMe", "Wi-Fi": "Wi-Fi"}.get(grp, grp)
        if grp == "RAM":
            ram_i = sum(1 for o in order[:i] if o[0] == "RAM") + 1
            name = f"RAM D{ram_i}"
        else:
            name = gs if lab.lower() in (grp.lower(), "composite", "wi-fi", "nic", "acpi") else f"{gs} {lab_short(lab)}"
        s.put(cx + 1, cy, ascii_only(name)[:11].ljust(11), "w")
        bt_meter(s, cx + 12, cy, colw - 19, f)
        s.put(cx + colw - 6, cy, f"{t:3.0f}°C", bt_grad(f))
    fx, fw = tw, w - tw
    fans = st["fans"]
    board_pwm = {p[1]: p for p in pwms if p[0] == "Board"}
    gpu_pwm = next((p for p in pwms if p[0] == "GPU"), None)
    bt_box(s, fx, y, fw, bh, 5, "cooling", BT["cool"], right=f"{sum(1 for f_ in fans if f_[1] > 0)}/{len(fans)} spinning")
    s.put(fx + 2, y + 1, "fan", "K"); s.put(fx + 10, y + 1, "rpm", "K"); s.put(fx + fw - 12, y + 1, "pwm", "K")
    for i, (name, rpm) in enumerate(fans[: bh - 3]):
        yy = y + 2 + i
        num = re.search(r"(\d+)$", name)
        p = gpu_pwm if name.startswith("GPU") else (board_pwm.get(int(num.group(1))) if num else None)
        s.put(fx + 2, yy, ("gpu" if name.startswith("GPU") else f"fan{num.group(1) if num else '?'}").ljust(6), "w")
        bt_meter(s, fx + 8, yy, fw - 28, rpm / 3000, "B")
        s.put(fx + fw - 20, yy, f"{rpm:5.0f}", "W")
        if p:
            bt_meter(s, fx + fw - 14, yy, 6, p[2], "b")
            mode = {"0": "off", "1": "man", "2": "thm", "5": "auto"}.get(p[3] or "", "")
            s.put(fx + fw - 7, yy, f"{p[2] * 100:3.0f}%", "w")

    # ============================================================ 6 net | 7 power ====
    y = y + bh
    bh = h - y
    nw = half if wide else 50
    _, rx, tx = st["net"]
    iface = st["net"][0] or "net"
    bt_box(s, 0, y, nw, bh, 6, "net", BT["net"], right=iface)
    top = max(max(st["hist"]["rx"], default=0), max(st["hist"]["tx"], default=0), 64 * 1024)
    hh = (bh - 2) // 2
    down = lambda f: "b" if f < 0.5 else ("B" if f < 0.8 else "W")
    upc = lambda f: "m" if f < 0.5 else ("M" if f < 0.8 else "W")
    bt_graph(s, 1, y + 1, nw - 2, hh, st["hist"]["rx"], 0, top, down, up=True)
    bt_graph(s, 1, y + 1 + hh, nw - 2, bh - 2 - hh, st["hist"]["tx"], 0, top, upc, up=False)
    s.put(2, y + 1, f"▼ {human(rx)}/s", "W")
    s.put(2, y + bh - 2, f"▲ {human(tx)}/s", "W")
    s.put(nw - 16, y + 1, f"top {human(top)}/s"[:14], "K")
    px, pw = nw, w - nw
    bt_box(s, px, y, pw, bh, 7, "power", BT["power"], right=f"gpu {gpow or 0:.0f}W  vcore "
           + (f"{next((v for gg, n_, v in volts if n_ == 'VCORE'), 0):.3f}V"))
    gph = bh - 2
    gpw_w = max(16, pw // 4) if wide else 16
    bt_graph(s, px + 1, y + 1, gpw_w, gph, pn.hist["gpw"], 0, gcap or 100)
    s.put(px + 2, y + 1, f"{gpow or 0:.0f}W", "W")
    s.put(px + 2, y + bh - 2, "gpu power", "K")
    rx0 = px + gpw_w + 2
    rw = pw - gpw_w - 3
    ncol = -(-len(volts) // gph) if volts else 1
    per = -(-len(volts) // ncol) if volts else 1     # even columns, not one full + one stub
    colw = rw // max(ncol, 1)
    for i, (grp, name, v) in enumerate(volts):
        cx = rx0 + (i // per) * colw
        cy = y + 1 + i % per
        top_v = rail_scale(pn.vtop.setdefault(f"{grp}{name}", v))
        s.put(cx, cy, {"VCORE": "vcore", "VDDGFX": "vgfx"}.get(name, name.lower())[:6].ljust(6), "w")
        bt_meter(s, cx + 6, cy, colw - 14, v / top_v, "Y")
        s.put(cx + colw - 7, cy, f"{v:5.3f}", "W")
    # services + model along the bottom border
    sx = 2
    for u, stt in st["services"]:
        name = ascii_only(u)
        s.put(sx, h - 1, "┤", BT["power"] if sx > px else BT["net"])
        s.put(sx + 1, h - 1, name, "G" if stt == "active" else "R")
        s.put(sx + 1 + len(name), h - 1, "├", BT["power"] if sx > px else BT["net"])
        sx += len(name) + 3
        if sx > w - 30:
            break
    if st["extra"]:
        e = ascii_only(st["extra"][0])
        s.put(w - len(e) - 3, h - 1, f"┤{e}├", "y")

