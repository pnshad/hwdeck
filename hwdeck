    # memory
    mw_ = cols[2]
    header(s, cx[2], y, mw_, "memory", "MEM0")
    ml = [("USE", m["used"] / m["total"]), ("CAC", m["cached"] / m["total"]),
          ("SWP", (m["swap_used"] / m["swap_total"]) if m["swap_total"] else 0)]
    lw_ = max(2, (mw_ - 14 - (len(ml) - 1)) // len(ml))
