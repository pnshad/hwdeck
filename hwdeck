# zone -> (title, box colour, ceiling °C where the meter is full and the reading turns red)
ZONES = {"cpu": ("cpu", "g", 100), "fans": ("fans", "b", 0), "battery": ("battery", "y", 60),
         "board": ("board", "c", 95), "skin": ("skin & air", "m", 50), "storage": ("storage", "C", 80),
         "other": ("other", "w", 100)}
CHIP_ZONE = {"coretemp": "cpu", "k10temp": "cpu", "zenpower": "cpu", "nvme": "storage", "drivetemp": "storage",
             "BAT": "battery", "amdgpu": "board", "iwlwifi": "board", "pch": "board", "acpitz": "board"}

def no_sensor(v):
    """applesmc reports absent sensors as -127, -44.25, -0.25 or 0."""
    return v is None or v <= 1.0 or v >= 130

def thermal_channels():
    """[(zone, name, key, guess, °C or None, ceiling)] and [(label, key, rpm, min, max, target, manual)]
    for every hwmon chip, read straight from sysfs. applesmc keeps its files on the platform
    device rather than in the hwmon directory, so a hwmon with no channels falls back to device/."""
    temps, fans = [], []
    root = "/sys/class/hwmon"
    for hw in sorted(os.listdir(root), key=lambda x: (len(x), x)) if os.path.isdir(root) else []:
        base = f"{root}/{hw}"
        files = os.listdir(base)
        if not any(re.fullmatch(r"(temp|fan)\d+_input", f) for f in files) and os.path.isdir(base + "/device"):
            base = os.path.realpath(base + "/device")
            files = os.listdir(base)
        chip = read(f"{root}/{hw}/name") or read(base + "/name") or hw
        smc = chip == "applesmc"
        zone = next((z for p, z in CHIP_ZONE.items() if chip.startswith(p)), "other")
        for f in sorted(files, key=lambda x: (len(x), x)):
            m = re.fullmatch(r"(temp|fan)(\d+)_input", f)
            if not m:
                continue
            ch = f"{m.group(1)}{m.group(2)}"
            raw = read(f"{base}/{f}")
            v = int(raw) if raw and raw.lstrip("-").isdigit() else None
            lab = (read(f"{base}/{ch}_label") or "").strip()
            if m.group(1) == "fan":
                num = {k: read(f"{base}/{ch}_{k}") for k in ("min", "max", "output", "manual")}
                num = {k: int(x) if x and x.isdigit() else None for k, x in num.items()}
                fans.append((lab or ch, ch, v or 0, num["min"], num["max"], num["output"], num["manual"]))
                continue
            t = v / 1000 if v is not None else None
            crit = read(f"{base}/{ch}_crit") or read(f"{base}/{ch}_max")
            crit = int(crit) / 1000 if crit and crit.isdigit() and 40_000 < int(crit) < 130_000 else None
            if smc:
                z, name, guess = SMC.get(lab, ("other", lab or ch, True))
                temps.append((z, name, lab or ch, guess, t, ZONES[z][2]))
            else:
                name = lab.replace("Package id 0", "CPU package").replace("Composite", "NVMe composite")
                name = re.sub(r"^Core (\d+)", r"core \1", name) or f"{chip} {ch}"
                if chip.startswith("BAT"):
                    name = f"{chip} pack"
                temps.append((zone, name, ch, False, t, crit or ZONES[zone][2]))
    return temps, fans

def th_hist(pn, key, v):
    d = pn.hist.setdefault(key, deque(maxlen=HIST))
    d.append(v)
    return d

def th_pack(boxes, ncols):
    """Greedy pack of [zone, natural height] into the shortest column, in zone order."""
    cols = [[] for _ in range(ncols)]
    for z, nat in boxes:
        min(cols, key=lambda c: sum(n for _, n in c)).append([z, nat])
    return cols

def th_layout(boxes, ncols, avail):
    """Stretch each column to fill `avail` rows (spare rows go to the graphs), or trim rows
    off its tallest box when short; a box that still does not fit is dropped and returned."""
    cols, dropped = th_pack(boxes, ncols), []
    for c in cols:
        while c and sum(n for _, n in c) > avail and max(n for _, n in c) > 3:
            max(c, key=lambda b: b[1])[1] -= 1
        while c and sum(n for _, n in c) > avail:
            dropped.append(c.pop()[0])
        spare = avail - sum(n for _, n in c)
        for i, b in enumerate(c):
            b[1] += spare // len(c) + (1 if i < spare % len(c) else 0)
    return cols, dropped

def th_rows(s, x, y, w, n, rows):
    """Sensor rows: friendly name, the raw key where there is room, a meter and the value,
    both in the temperature colour. Returns rows drawn."""
    kw = 7 if w >= 44 else 0
    namew = max(8, min(22, w - 13 - kw))
    meterw = w - namew - kw - 7
    shown = rows if len(rows) <= n else rows[: n - 1]
    for i, (name, key, guess, t, ceil) in enumerate(shown):
        f = (t - 20) / (ceil - 20)
        s.put(x, y + i, ascii_only(name)[:namew], ch(GREY))
        if kw:
            s.put(x + namew + 1, y + i, key[:5] + ("?" if guess else ""), ch(faint(GREY, 0.6)))
        if meterw >= 3:
            vw_meter(s, x + namew + 1 + kw, y + i, meterw, f, temp_c(f))
        s.put(x + w - 5, y + i, f"{t:3.0f}°C", temp_c(f))
    if len(rows) > n:
        s.put(x, y + n - 1, f"+{len(rows) - n + 1} more", GREY)
    return len(shown)

def fan_follows(cpu):
    """The temperature a fan loop answers to: the SMC's fan-control die key (TC0F) on a Mac,
    else the hottest CPU sensor. Rows as vw_temps gives them; None without any."""
    return next((r for r in cpu if r[1] == "TC0F"), max(cpu, key=lambda r: r[3], default=None))

def th_fans(s, x, y, w, n, fans, fol=None):
    """Fan rows: name, key, meter, rpm and % of max; under it, when each fan has two rows, the
    temperature the fan follows and its min-max. On one row the temperature joins the value."""
    per = 2 if n >= 2 * len(fans) else 1
    kw = 6 if w >= 44 else 0
    namew = max(5, min(14, w - 30 - kw))
    ff = (fol[3] - 20) / (fol[4] - 20) if fol else 0
    for i, (lab, key, rpm, lo, mx, tgt, man) in enumerate(fans[: max(1, n // per)]):
        yy = y + i * per
        f = rpm / mx if mx else 0
        lab = ascii_only(lab)
        s.put(x, yy, (lab if len(lab) <= namew else lab.split()[0])[:namew], ch(GREY))
        if kw:
            s.put(x + namew + 1, yy, key[:5], ch(faint(GREY, 0.6)))
        val = [(f"{rpm:5d} rpm {f * 100:3.0f}%", TEXT)]
        if per == 1 and fol:
            val = [(f"{rpm:5d} {f * 100:3.0f}%", TEXT), (f" {fol[3]:3.0f}°", temp_c(ff))]
        vl = vw_len(val)
        if w - namew - kw - vl - 2 >= 3:
            vw_meter(s, x + namew + 1 + kw, yy, w - namew - kw - vl - 2, f, ICE)
        vw_runs(s, x + w - vl, yy, val, TEXT, vl)
        if per == 2:
            room = w - namew - 1
            fx = x + namew + 1
            if fol:
                t = f"follows {fol[3]:.0f}°C {fol[1]}  "
                s.put(fx, yy + 1, t[:room], temp_c(ff))
                fx, room = fx + len(t), room - len(t)
            rng = f"{lo or 0}-{mx or 0} rpm  {'manual' if man else 'auto'}"
            if len(rng) <= room or not fol:              # whole, or not at all
                s.put(fx, yy + 1, rng[: max(0, room)], faint(GREY, 0.75))
    return min(len(fans), max(1, n // per)) * per

def draw_thermal(s, st, cfg, pn):
    pn.tick += 1
    temps, fans = thermal_channels()
    if not temps and not fans:
        s.put(0, 0, "hwdeck thermal: this machine has no hwmon temperature or fan channels", AMBER)
        return
    hide = cfg.get("hide_sensors", [])
    temps = [t for t in temps if not any(re.search(p, f"{t[1]} {t[2]}", re.I) for p in hide)]
    live = [t for t in temps if not no_sensor(t[4])]
    dead = [t for t in temps if no_sensor(t[4])]
    zones = {}
    for z, name, key, guess, t, ceil in live:
        zones.setdefault(z, []).append((name, key, guess, t, ceil))
    order = [z for z in ZONES if z in zones or (z == "fans" and fans)]
    for z in order:                                      # one history per zone: its hottest reading
        if z == "fans":
            th_hist(pn, "th:fans", max((r / mx * 100 for _, _, r, _, mx, _, _ in fans if mx), default=0))
        else:
            th_hist(pn, f"th:{z}", max(r[3] for r in zones[z]))
    hot = max(live, key=lambda t: t[4], default=None)
    fol = fan_follows(zones.get("cpu", []))
    hf = (hot[4] - 20) / (hot[5] - 20) if hot else 0
    dh = th_hist(pn, "th:hot", hot[4] if hot else 0)
    acc = temp_c(hf)

    # the hottest sensor as the LED readout; the zones' maxima sit in their section headings
    spin = sum(1 for f in fans if f[2] > 0)
    side = [(IC["temp"], "hottest", ascii_only(hot[1]) if hot else "--"),
            ("", "sensor", f"{hot[2]} in {ZONES[hot[0]][0]}" if hot else "--")]
    if fans:
        side.append((IC["fan"], "fans", " · ".join(str(f[2]) for f in fans) + " rpm"))
    side.append(("", "sensors", f"{len(live)} live · {len(dead)} no sensor"))
    hero = {"color": acc, "rw": 56,
            "rows": [{"big": f"{hot[4] if hot else 0:3.0f}".replace(" ", "_"), "unit": "°C", "c": acc, "side": side,
                      "row": [("hottest", hf, f"{ascii_only(hot[1]) if hot else '--'}  {hot[4] if hot else 0:.0f}°C", acc, acc),
                              f"{len(live)} live · {len(dead)} no sensor" + (f" · fans {' '.join(str(f[2]) for f in fans)} rpm" if fans else "")]}],
            "graphs": [(dh, 20, hot[5] if hot else 100, f"{hot[4] if hot else 0:.0f}°C  hottest", temp_c)]}

    secs = []
    for z in order:
        if z == "fans":
            secs.append({"title": "fans", "icon": IC["fan"], "color": ICE, "right": f"{spin}/{len(fans)} spinning",
                         "lines": 2 * len(fans), "rw": 64, "fn": lambda s_, x, y, w, n: th_fans(s_, x, y, w, n, fans, fol),
                         "graphs": [(pn.hist["th:fans"], 0, 100, f"{pn.hist['th:fans'][-1]:.0f}%  fastest", ICE)]})
            continue
        rows = sorted(zones[z], key=lambda r: not r[1].startswith("temp"))   # hwmon chips first, then SMC
        mz = max(rows, key=lambda r: r[3])
        ceil = max(r[4] for r in rows)
        secs.append({"title": ZONES[z][0], "icon": IC["temp"], "color": temp_c((mz[3] - 20) / (mz[4] - 20)),
                     "right": f"max {mz[3]:.0f}°C · {len(rows)}", "lines": len(rows), "rw": 64,
                     "fn": lambda s_, x, y, w, n, rows=rows: th_rows(s_, x, y, w, n, rows),
                     "graphs": [(pn.hist[f"th:{z}"], 20, ceil, f"{mz[3]:.0f}°C  {ascii_only(mz[0])}", temp_c)]})

    # the no-sensor strip: raw readings, wrapped to the column; one line on a short terminal
    def no_sensor_box(cw):
        words = [f"{t[2]} {t[4]:g}" if t[4] is not None else f"{t[2]} --" for t in dead]
        lines, cur = [], ""
        for wd in words:
            if cur and len(cur) + 3 + len(wd) > cw - 5:     # room for the "+N" tail
                lines.append(cur)
                cur = ""
            cur = f"{cur}   {wd}" if cur else wd
        if cur:
            lines.append(cur)
        keep = 1 if s.h < 30 else max(1, s.h // 12)
        if len(lines) > keep:
            rest = sum(ln.count("   ") + 1 for ln in lines[keep:])
            lines = lines[:keep]
            lines[-1] += f"   +{rest}"
        return {"title": "no sensor", "color": GREY, "right": "raw readings", "rows": lines}

    # fewest columns that show every row under the smallest hero (2 on a wide screen, 3 on a
    # very wide one); a fan gives up its detail row before a sensor row is cut
    iw, ih = s.w - 4, s.h - 2
    hmin = 6 if ih >= 40 else 1
    maxc = max(1, min(3, s.w // 32, len(secs)))       # two sensor columns from 64 wide
    minc = min(maxc, 1 if s.w < 124 else (2 if s.w < 270 else 3))
    fit = lambda bs, n: max(sum(b[1] for b in c) for c in th_pack(bs, n)) <= ih - hmin
    choice = None
    for per in (2, 1):
        for n in range(minc, maxc + 1):
            cw = (iw - 3 * (n - 1)) // n
            bs = secs + ([no_sensor_box(cw)] if dead else [])
            for b in bs:
                if b["title"] == "fans":
                    b["lines"] = per * len(fans)
            if fit([(i, vw_nat(b)) for i, b in enumerate(bs)], n):
                choice = (bs, n)
                break
        if choice:
            break
    bs, ncols = choice or (secs + ([no_sensor_box((iw - 3 * (maxc - 1)) // maxc)] if dead else []), maxc)
    hero["min"] = hmin
    vw_layout(s, st, (IC["temp"], "thermal", acc, ascii_only(cfg.get("title") or st["host"])), hero, bs, ncols)

# ================================================================== views ====
# One thing per screen, full size, for a tap on the Touch Bar strip or a hotkey: --view cpu,
# memory, fans, battery or thermal (--style thermal is the same screen). Drawn in the strip's
# visual language rather than btop's: pure black, one accent colour per subject (the strip's
# heading icons: cpu mint, fans cyan, memory violet, temperatures cyan warming through amber
# to red, battery red-yellow-green by charge), grey labels, a 7-segment LED readout for the
# big number like the strip's clock, and a Nerd Font icon before the headings and the main
# values. One rounded frame in the accent holds a hero (the readout, its facts beside it, its
# rows and the history graph) and then sections packed into columns by th_layout. A section
# is a dict of rows and graphs; a row is
#   (name, frac, value, meter colour[, value colour])   frac None = no meter; value may
#                                                       be a tuple of (text, colour) runs
#   [row, row]                                          drawn side by side
#   {"big": digits, "unit": text, "c": colour,          LED readout ("_" = an unlit digit)
#    "side": [(icon, label, value[, colour])],          with facts beside it, and the
#    "row": fallback}                                   fallback row or rows (or nothing) when short
#   "text"                                              a dim note;  None = blank line

VIEWS = ("cpu", "memory", "fans", "battery", "power", "network", "thermal")
NERD = os.environ.get("TERM") != "linux"                 # the kernel console has no Nerd Font
IC = {k: chr(v) if NERD else "" for k, v in (("cpu", 0xF061A), ("temp", 0xF050F), ("fan", 0xF0210),
                                             ("mem", 0xF035B), ("plug", 0xF06A5), ("bat", 0xF0079),
                                             ("net", 0xF0928))}
BAT_GLYPHS = (0xF008E, 0xF007A, 0xF007B, 0xF007C, 0xF007D, 0xF007E, 0xF007F, 0xF0080, 0xF0081, 0xF0082, 0xF0079)

def level(v, cool, warm, hot, base):
    """The strip's heat(): `base` up to `cool`, then toward amber at `warm` and red at `hot`."""
    if v <= warm:
        return mix(base, AMBER, (v - cool) / (warm - cool))
    return mix(AMBER, RED, (v - warm) / (hot - warm))

def temp_c(f):
    """A temperature's colour from its 0..1 place between 20 °C and the sensor's ceiling:
    cyan at rest, amber, red. The breaks are the strip's 50 / 72 / 90 °C on the CPU's 100."""
    return level(f, 0.375, 0.65, 0.875, ICE)

def charge_c(pct, limit=None):
    """Red when empty, yellow at 50 %, green at the charge limit (the strip's charge_color)."""
    if pct <= 50:
        return mix(RED, VOLT, pct / 50)
    return mix(VOLT, GREEN, (pct - 50) / max(1, (limit or 100) - 50))

SEG_L = 3            # every view's readout: 5 rows, 5 columns a digit, the unit on its bottom row
SEG7 = {"0": "abcdef", "1": "bc", "2": "abdeg", "3": "abcdg", "4": "bcfg", "5": "acdfg", "6": "acdefg",
        "7": "abc", "8": "abcdefg", "9": "abcdfg", "-": "g", "_": ""}

def seg7_w(text, L, unit=""):
    return sum(2 if ch == "." else L + 3 for ch in text) - 1 + (len(unit) + 1 if unit else 0)

def seg7(s, x, y, text, c, L=3):
    """Digits as a 7-segment LED readout, like the strip's clock: lit segments in `c`, unlit
    ones faintly visible. A digit is (L+2) x (2L+3) square pixels, two to a cell with half
    blocks, so it stands L+2 rows. "_" is a digit with nothing lit, "." a lit dot. Returns
    the width drawn."""
    H, px, cx = 2 * L + 3, {}, 0
    for ch in text:
        if ch == ".":
            px[cx, H - 1] = c
            cx += 2
            continue
        lit = SEG7.get(ch, "")
        span = range(1, L + 1)
        segs = {"a": [(i, 0) for i in span], "g": [(i, L + 1) for i in span], "d": [(i, H - 1) for i in span],
                "f": [(0, j) for j in span], "b": [(L + 1, j) for j in span],
                "e": [(0, j + L + 1) for j in span], "c": [(L + 1, j + L + 1) for j in span]}
        for name, pts in segs.items():
            for p in pts:
                px[cx + p[0], p[1]] = c if name in lit else faint(c, 0.16)
        cx += L + 3
    for col in range(cx):
        for row in range(L + 2):
            top, bot = px.get((col, 2 * row)), px.get((col, 2 * row + 1))
            if top and bot:
                s.put(x + col, y + row, "█" if top == bot else "▀", top, None if top == bot else bot)
            elif top or bot:
                s.put(x + col, y + row, "▀" if top else "▄", top or bot)
    return cx - 1

def vw_frame(s, icon, title, c, right):
    """The view's one rounded frame: its edge in the accent, the icon and title set into the
    top edge in full accent, the clock and a note in grey."""
    w, h = s.w, s.h
    edge = ch(mix(BLACK, c, 0.55))
    s.put(0, 0, "╭" + "─" * (w - 2) + "╮", edge)
    for y in range(1, h - 1):
        s.put(0, y, "│", edge)
        s.put(w - 1, y, "│", edge)
    s.put(0, h - 1, "╰" + "─" * (w - 2) + "╯", edge)
    head = f" {icon} {title} " if icon else f" {title} "
    s.put(2, 0, head, ch(c))
    note = f" {right} "[: max(0, w - len(head) - 8)] if right else ""
    rx = w - 3 - len(note)
    if len(note) > 3:
        s.put(rx, 0, note, ch(GREY))
    clock = f" {time.strftime('%H:%M:%S')} "
    cx = (w - len(clock)) // 2
    if cx > 3 + len(head) and cx + len(clock) < rx:
        s.put(cx, 0, clock, ch(GREY))

def vw_head(s, x, y, w, icon, title, c, right=""):
    """A section heading: icon and title in its colour, a faint rule, a grey note."""
    head = f"{icon} {title}" if icon else title
    s.put(x, y, head[:w], ch(c))
    right = right[: max(0, w - len(head) - 6)]
    s.put(x + len(head) + 1, y, "─" * max(0, w - len(head) - 1 - (len(right) + 1 if right else 0)), ch(faint(c, 0.45)))
    if right:
        s.put(x + w - len(right), y, right, ch(GREY))

def vw_meter(s, x, y, w, frac, c):
    """A thin bar: lit in `c`, the rest a faint track of the same colour."""
    n = round(max(0.0, min(1.0, frac)) * w)
    s.put(x, y, "━" * n, c)
    s.put(x + n, y, "━" * (w - n), faint(c, 0.22))

def vw_len(val):
    return len(val) if isinstance(val, str) else sum(len(t) for t, _ in val)

def vw_runs(s, x, y, val, c, w):
    """A value as plain text in `c`, or as (text, colour) runs; cut at width w."""
    for txt, cc in ((val, c),) if isinstance(val, str) else val:
        s.put(x, y, txt[: max(0, w)], cc)
        x, w = x + len(txt), w - len(txt)

def vw_line(s, x, y, w, r, namew, valw, acc):
    name, frac, val, c, vc = (r + (None, TEXT))[:5] if len(r) == 3 else (r + (TEXT,))[:5]
    s.put(x, y, name[:namew], ch(GREY))
    if isinstance(val, str):
        val = val[: max(0, w - namew - 1)]
    if frac is not None and w - namew - valw - 2 >= 3:
        vw_meter(s, x + namew + 1, y, w - namew - valw - 2, frac, c or acc)
    vw_runs(s, x + w - vw_len(val), y, val, vc, w)

def vw_lines(rows):
    return sum(r.get("L", 3) + 2 if isinstance(r, dict) else 1 for r in rows)

def vw_rows(s, x, y, w, n, rows, acc, keep_big=False):
    """Rows into a w x n area; returns the lines used. A readout falls back to its plain row
    when it does not fit (keep_big: unless only the rows under it would be cut), and rows past
    the bottom collapse into "+N more"."""
    big = lambda r: isinstance(r, dict)
    if (vw_lines(rows) > n and not (keep_big and n >= SEG_L + 4)) or any(big(r) and seg7_w(r["big"], r.get("L", 3), r.get("unit", "")) > w for r in rows):
        rows = [x for r in rows for x in (r.get("row") if big(r) and isinstance(r.get("row"), list) else
                                          [r.get("row") if big(r) else r])]   # "row" may be a list of rows
        rows = [r for i, r in enumerate(rows) if r is not None or 0 < i < len(rows) - 1]
    lines = [r.get("L", 3) + 2 if big(r) else 1 for r in rows]
    if sum(lines) > n:
        k = next(i for i in range(len(rows)) if sum(lines[: i + 1]) > n - 1)
        rows = rows[:k] + [f"+{len(rows) - k} more"] if n > 1 else rows[:n]
    single = [r for r in rows if isinstance(r, tuple)]
    multi = [t for r in rows if isinstance(r, list) for t in r]
    def widths(rs, cw):                                 # name and metered-value widths; a line of
        vw = max((vw_len(t[2]) for t in rs if t[1] is not None), default=0)    # plain values lets
        if all(t[1] is None for t in rs):               # names take what the values leave
            return min(max((len(t[0]) for t in rs), default=0), cw - max((vw_len(t[2]) for t in rs), default=0) - 1), 0
        return min(max((len(t[0]) for t in rs), default=0), max(4, cw * 2 // 5)), vw
    yy = y
    for r in rows:
        if isinstance(r, str):
            s.put(x, yy, r[:w], faint(GREY, 0.75))
        elif big(r):
            L, c = r.get("L", 3), r["c"]
            bw = seg7(s, x, yy, r["big"], c, L)
            if r.get("unit"):
                s.put(x + bw + 1, yy + L + 1, r["unit"], c)
                bw += len(r["unit"]) + 1
            side = r.get("side", [])[: L + 2]
            sx = x + bw + 4
            lw = max((len(t[1]) for t in side), default=0)
            ic = any(t[0] for t in side)
            for i, t in enumerate(side):
                if sx + lw + 4 > x + w:
                    break
                s.put(sx, yy + i, t[0], ch(c))
                lx = sx + (2 if ic else 0)
                s.put(lx, yy + i, t[1], ch(GREY))
                vw_runs(s, lx + lw + 2, yy + i, t[2], t[3] if len(t) > 3 else TEXT, x + w - lx - lw - 2)
            yy += L + 1
        elif isinstance(r, list):
            cw = (w - 3 * (len(r) - 1)) // len(r)
            nw, vw = widths(r if all(t[1] is None for t in r) else multi, cw)
            for i, t in enumerate(r):
                vw_line(s, x + i * (cw + 3), yy, cw, t, nw, vw, acc)
        elif r is not None:
            vw_line(s, x, yy, w, r, *widths(single, w), acc)
        yy += 1
    return yy - y

def vw_graphs(s, x, y, w, h, graphs, st, acc, across=False):
    """History graphs, stacked (or side by side: across), each labelled with its value and the
    time it spans; one colour deepening toward the top, or a function of height for a level
    gradient (temperatures, charge). A faint floor under each, so an empty graph still reads
    as one. Two rows make a label over a strip; one row is a bare sparkline."""
    if across:
        n = min(len(graphs), max(0, (w + 2) // 14))
        gw = [(w - 2 * (n - 1)) // n + (1 if i < (w - 2 * (n - 1)) % n else 0) for i in range(n)] if n else []
        boxes = [(x + sum(gw[:i]) + 2 * i, y, gw[i], h) for i in range(n)]
    else:
        n = min(len(graphs), h // 3 or h // 2 or h)
        gh = [h // n + (1 if i < h % n else 0) for i in range(n)] if n else []
        boxes = [(x, y + sum(gh[:i]), w, gh[i]) for i in range(n)]
    if n <= 0 or w < 12:
        return
    for (gx, gy, ww, hh), (d, lo, hi, lab, c) in zip(boxes, graphs):
        c = c or acc
        grad = c if callable(c) else (lambda f, c=c: mix(faint(c, 0.45), c, f))
        s.put(gx, gy + hh - 1, "▁" * ww, faint(grad(0), 0.35))
        bt_graph(s, gx, gy, ww, hh, d, lo, hi, grad)
        if hh >= 2:
            s.put(gx, gy, lab[: ww - 9], TEXT)
            span = len(d) * st.get("interval", 2.0)
            if ww - len(lab) >= 16:
                s.put(gx + ww - 7, gy, f"{span / 60:4.1f}m"[-7:], GREY)

def vw_nat(b, head=True):
    return (1 if head else 0) + (b.get("lines") or vw_lines(b.get("rows", [])))

def vw_side(b, w):
    """Whether a box's graphs go beside its rows (a graph narrower than 32 says little)."""
    return bool(b.get("graphs")) and w - min(w, b.get("rw", 58)) >= 34

def vw_box(s, x, y, w, h, b, st, head=True):
    """A section: its heading, then rows (or b["fn"]) with the graphs beside them on the left,
    like btop's cpu box, or under them on a narrow column. head=False is the hero, whose
    heading is the frame's top edge."""
    acc = b["color"]
    if head:
        vw_head(s, x, y, w, b.get("icon", ""), b["title"], acc, b.get("right", ""))
        y, h = y + 1, h - 1
    side = vw_side(b, w)
    rw = min(w, b.get("rw", 58)) if side else w
    draw_rows = b.get("fn") or (lambda s_, x_, y_, w_, n_: vw_rows(s_, x_, y_, w_, n_, b.get("rows", []), acc, b.get("keep_big")))
    used = draw_rows(s, x + w - rw, y, rw, h)
    if side:
        vw_graphs(s, x, y, w - rw - 2, h, b["graphs"], st, acc, b.get("across"))
    elif h - used >= (1 if b.get("spark") else 2 if not head else 3):
        gap = 1 if h - used >= 5 else 0
        vw_graphs(s, x, y + used + gap, w, h - used - gap, b.get("graphs") or [], st, acc, b.get("across"))

def vw_layout(s, st, top, hero, boxes, ncols):
    """One frame (top = icon, title, accent, note), the hero under its edge and sections in
    columns under the hero; spare rows go mostly to the hero's graph. Short screens drop the
    readout for its plain row, trim rows and drop the last sections (each view lists them
    most important first)."""
    w, h = s.w, s.h
    vw_frame(s, *top)
    iw, ih, gap = w - 4, h - 2, 3
    ncols = max(1, min(ncols, len(boxes))) if boxes else 1
    colw = lambda n: [(iw - gap * (n - 1)) // n + (1 if i < (iw - gap * (n - 1)) % n else 0) for i in range(n)]
    cw = min(colw(ncols))
    bigs = [(r, iw) for r in (hero or {}).get("rows", []) if isinstance(r, dict)]
    bigs += [(r, cw) for b in boxes for r in b.get("rows", []) if isinstance(r, dict)]
    hgraph = 0 if not hero or not hero.get("graphs") or vw_side(hero, iw) else 3
    for r, _ in bigs:
        r["L"] = SEG_L
    hd = vw_nat(hero, False) + hgraph if hero else 0
    dnat = max((sum(n for _, n in c) for c in th_pack([(i, vw_nat(b)) for i, b in enumerate(boxes)], ncols)), default=0)
    hh = 0
    if hero:
        if not boxes:
            hh = ih
        elif hd + dnat <= ih:
            hh = hd + (int((ih - hd - dnat) * hero.get("grow", 0.6)) if hero.get("graphs") else 0)
        else:
            hh = max(min(hd, hero.get("min", max(6, ih // 2))), ih - dnat)
        vw_box(s, 2, 1, iw, hh if boxes and ih - hh >= 3 else ih, hero, st, head=False)
    if not boxes or ih - hh < 3:
        return
    # a section shorter than four rows says little: drop the last sections until the rest fit
    nat = [(i, vw_nat(b)) for i, b in enumerate(boxes)]
    while len(nat) > 1 and max(sum(min(n, 4) for _, n in c) for c in th_pack(nat, ncols)) > ih - hh:
        nat.pop()
    ncols = min(ncols, len(nat))
    cols, _ = th_layout(nat, ncols, ih - hh)
    cws = colw(ncols)
    for ci, col in enumerate(cols):
        x, y = 2 + sum(cws[:ci]) + gap * ci, 1 + hh
        for i, bh in col:
            vw_box(s, x, y, cws[ci], bh, boxes[i], st)
            y += bh

def vw_temps(zone):
    """Live rows of one thermal zone, hwmon chips first then SMC keys, for th_rows."""
    rows = [(name, key, guess, t, ceil) for z, name, key, guess, t, ceil in thermal_channels()[0]
            if z == zone and not no_sensor(t)]
    return sorted(rows, key=lambda r: not r[1].startswith("temp"))

def vw_temp_box(pn, rows, title, key):
    if not rows:
        return None
    mz = max(rows, key=lambda r: r[3])
    d = th_hist(pn, key, mz[3])
    ceil = max(r[4] for r in rows)
    return {"title": title, "icon": IC["temp"], "color": temp_c((mz[3] - 20) / (mz[4] - 20)),
            "right": f"max {mz[3]:.0f}°C · {len(rows)}", "lines": len(rows),
            "fn": lambda s, x, y, w, n: th_rows(s, x, y, w, n, rows), "rw": 52,
            "graphs": [(d, 20, ceil, f"{mz[3]:.0f}°C  {ascii_only(mz[0])}", temp_c)]}

def ivals(path, *keys):
    """Integer sysfs files under one directory, None where unreadable."""
    out = []
    for k in keys:
        v = read(f"{path}/{k}")
        out.append(int(v) if v and v.lstrip("-").isdigit() else None)
    return out

def digits(v, n):
    """A number as n LED digits, the unused leading ones unlit."""
    return f"{v:{n}.0f}".replace(" ", "_")

# ------------------------------------------------------------------ cpu ----
def cpu_limits(n):
    """What can hold the CPU back, from what sysfs lets a user read: thermal-throttle
    counters, intel_pstate limits, and the kernel's cooling devices (ACPI passive steps,
    the TCC offset, idle injection)."""
    base = "/sys/devices/system/cpu"
    lim = {"throttle": None, "cool": {}}
    if os.path.isdir(f"{base}/cpu0/thermal_throttle"):
        seen, core_n, core_ms = set(), 0, 0
        for i, cid in enumerate(core_ids(n)):
            if cid not in seen:
                seen.add(cid)
                cn, cms = ivals(f"{base}/cpu{i}/thermal_throttle", "core_throttle_count", "core_throttle_total_time_ms")
                core_n, core_ms = core_n + (cn or 0), core_ms + (cms or 0)
        pk_n, pk_ms = ivals(f"{base}/cpu0/thermal_throttle", "package_throttle_count", "package_throttle_total_time_ms")
        lim["throttle"] = (core_n, core_ms, pk_n or 0, pk_ms or 0)
    lim["no_turbo"], lim["min_pct"], lim["max_pct"] = ivals(f"{base}/intel_pstate", "no_turbo", "min_perf_pct", "max_perf_pct")
    cf = f"{base}/cpu0/cpufreq"
    lim["gov"], lim["epp"], lim["driver"] = (read(f"{cf}/{k}") for k in ("scaling_governor", "energy_performance_preference", "scaling_driver"))
    lim["fmin"], lim["fmax"], lim["base"], lim["cap"] = (
        (v or 0) / 1e6 for v in ivals(cf, "cpuinfo_min_freq", "cpuinfo_max_freq", "base_frequency", "scaling_max_freq"))
    root = "/sys/class/thermal"
    for d in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        if d.startswith("cooling_device"):
            t = read(f"{root}/{d}/type") or ""
            cur, mx = ivals(f"{root}/{d}", "cur_state", "max_state")
            if t in ("Processor", "TCC Offset", "intel_powerclamp") and cur is not None:
                old = lim["cool"].get(t, (0, mx))
                lim["cool"][t] = (max(old[0], cur), mx)    # the most throttled of the cores
    return lim

def view_cpu(s, st, cfg, pn):
    k = pn.counters.sample().get("cpu", {})
    cores, total = st["cores"], st["cpu"]
    fq = core_freqs(len(cores))
    favg = sum(c for c, _ in fq) / len(fq) if fq else 0
    lim = cpu_limits(len(cores))
    temps = vw_temps("cpu")
    core_t = {int(m.group(1)): r[3] for r in temps if (m := re.fullmatch(r"core (\d+)", r[0]))}
    pkg = next((r for r in temps if r[0] == "CPU package"), max(temps, key=lambda r: r[3], default=None))
    ids = core_ids(len(cores))
    tcol = lambda t, ceil=100: temp_c((t - 20) / (ceil - 20))
    fmax = lim["fmax"] or max((m for _, m in fq), default=0) or 1
    small = s.h < 40                                     # pair rows up on a half-height window
    hits = lim["throttle"] and (lim["throttle"][0] or lim["throttle"][2])
    la = st["load"]

    side = [(IC["cpu"], "cores", f"{len(set(ids))} cores · {len(cores)} threads"),
            ("", "clock", f"{favg:.2f} of {fmax:.1f} GHz")]
    if pkg:
        side.append((IC["temp"], "package", f"{pkg[3]:.0f}°C", tcol(pkg[3], pkg[4])))
    side.append(("", "load avg", " ".join(f"{x:.2f}" for x in la)))
    if lim["throttle"]:
        side.append(("", "throttle", "throttled since boot" if hits else "never", RED if hits else GREEN))
    rows = [{"big": digits(total, 3), "unit": "%", "c": MINT, "side": side,
             "row": ("cpu", total / 100, f"{total:3.0f}%  {favg:.2f} GHz", MINT)}]
    crow = []
    for i, v in enumerate(cores):
        t = core_t.get(ids[i])
        val = ((f"{v:3.0f}%", TEXT), (f" {fq[i][0]:3.1f}G" if i < len(fq) else "", GREY))
        if t is not None:
            val += ((f" {t:3.0f}°", tcol(t)),)
        crow.append((f"C{i}", v / 100, val, MINT))
    rows += [crow[i:i + 2] for i in range(0, len(crow), 2)] if small or len(crow) > 8 else crow
    split = [("user", k.get("user", 0)), ("system", k.get("system", 0)), ("iowait", k.get("iowait", 0)),
             ("irq", k.get("irq", 0) + k.get("softirq", 0)), ("nice", k.get("nice", 0)), ("steal", k.get("steal", 0))]
    split = [(n, v) for n, v in split if n not in ("nice", "steal") or v > 0.001]
    if small:
        rows.append([(n, None, f"{v * 100:.1f}%") for n, v in split[:4]])
    else:
        rows.append(None)
        rows += [(n, v, f"{v * 100:5.1f}%", MINT) for n, v in split]
        rows.append(("load", la[0] / max(1, len(cores)), " ".join(f"{x:4.2f}" for x in la), MINT))
    hero = {"color": MINT, "rows": rows, "rw": 56,
            "graphs": [(st["hist"]["cpu"], 0, 100, f"{total:.0f}%  cpu", MINT)]}

    boxes = []
    tb = vw_temp_box(pn, temps, "temp", "v:cput")
    if tb:
        boxes.append(tb)
    thr = []
    if lim["throttle"]:
        cn, cms, pn_, pms = lim["throttle"]
        if hits:
            thr.append(("package", None, f"{pn_} times  {pms / 1000:.1f}s", None, RED if pn_ else GREEN))
            thr.append(("core", None, f"{cn} times  {cms / 1000:.1f}s", None, RED if cn else GREEN))
        else:
            thr.append(("throttled", None, "never since boot", None, GREEN))
    else:
        thr.append("thermal_throttle counters not exposed")
    if pkg:
        crit = pkg[4]
        thr.append(("headroom", (pkg[3] - 20) / (crit - 20), f"{crit - pkg[3]:.0f}°C to {crit:.0f}", tcol(pkg[3], crit), tcol(pkg[3], crit)))
    for t, name, unit in (("Processor", "passive", "steps"), ("TCC Offset", "TCC offset", "°C"), ("intel_powerclamp", "idle inject", "%")):
        if t in lim["cool"]:
            cur, mx = lim["cool"][t]
            thr.append((name, cur / mx if mx else 0, f"{cur}/{mx} {unit}" if unit == "steps" else f"{cur}{unit}", AMBER if cur else MINT))
    watts = pn.cpu_power()
    thr.append(("package W", None, f"{watts:.1f} W") if watts is not None else
               ("package W", None, "root-only" if os.path.exists("/sys/class/powercap/intel-rapl:0") else "no RAPL", None, GREY))
    boxes.append({"title": "throttle", "color": RED if hits else MINT, "rows": thr,
                  "right": "throttled" if hits else ("never" if lim["throttle"] else "")})
    dclk = th_hist(pn, "v:clk", favg)
    turbo = {0: ("on", GREEN), 1: ("off", AMBER)}.get(lim["no_turbo"], ("--", GREY))
    clk = [("clock", favg / fmax, f"{favg:.2f}/{fmax:.1f} GHz", MINT),
           ("turbo", None, turbo[0], None, turbo[1]),
           ("cap", lim["cap"] / fmax if lim["cap"] else None, f"{lim['cap']:.1f} GHz" if lim["cap"] else "--", MINT),
           ("governor", None, f"{lim['gov'] or '--'}" + (f" / {lim['epp']}" if lim["epp"] else ""))]
    if lim["max_pct"] is not None:
        clk.append(("perf", lim["max_pct"] / 100, f"{lim['min_pct']}-{lim['max_pct']}%", MINT))
    clk += [("range", None, f"{lim['fmin']:.1f}-{fmax:.1f} GHz" + (f" base {lim['base']:.1f}" if lim["base"] else "")),
            ("driver", None, lim["driver"] or "--")]
    boxes.append({"title": "clock", "color": MINT, "right": f"{favg:.2f} GHz", "rows": clk, "rw": 46,
                  "graphs": [(dclk, 0, fmax, f"{favg:.2f} GHz", MINT)]})
    # most important first: a short screen drops the last
    vw_layout(s, st, (IC["cpu"], "cpu", MINT, ascii_only(st["cpu_model"])), hero, boxes,
              1 if s.w < 60 else (2 if s.w < 200 else 3))

# --------------------------------------------------------------- memory ----
def meminfo():
    m = {}
    for line in (read("/proc/meminfo", "") or "").splitlines():
        k, v = line.split(":", 1)
        m[k] = int(v.split()[0]) * 1024
    return m

def top_mem(n):
    """Resident memory per program name, summed over its processes, from /proc/*/statm:
    two small reads per process, cheap enough to do every refresh. Shared pages count
    once per process, so a family of processes reads a little high."""
    page, agg = os.sysconf("SC_PAGE_SIZE"), {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        f = (read(f"/proc/{pid}/statm") or "").split()
        rss = int(f[1]) * page if len(f) > 1 else 0
        if rss:                                          # kernel threads have none
            a = agg.setdefault(read(f"/proc/{pid}/comm") or pid, [0, 0])
            a[0] += rss
            a[1] += 1
    return sorted(((ascii_only(k), *v) for k, v in agg.items()), key=lambda r: -r[1])[:n]

def view_memory(s, st, cfg, pn):
    m = meminfo()
    tot = m.get("MemTotal", 1)
    avail = m.get("MemAvailable", 0)
    used = tot - avail
    swt, swu = m.get("SwapTotal", 0), m.get("SwapTotal", 0) - m.get("SwapFree", 0)
    cache = m.get("Cached", 0) + m.get("Buffers", 0)
    pc = lambda v, t=tot: f"{human(v):>7} {v / t * 100 if t else 0:3.0f}%"
    side = [(IC["mem"], "used", f"{human(used)} of {human(tot)}"), ("", "available", human(avail)),
            ("", "cache", f"{human(cache)} with buffers"),
            ("", "swap", f"{human(swu)} of {human(swt)}" if swt else "none")]
    meters = [("used", used / tot, pc(used), VIOLET), ("available", avail / tot, pc(avail), VIOLET),
              ("cached", m.get("Cached", 0) / tot, pc(m.get("Cached", 0)), VIOLET),
              ("buffers", m.get("Buffers", 0) / tot, pc(m.get("Buffers", 0)), VIOLET),
              ("free", m.get("MemFree", 0) / tot, pc(m.get("MemFree", 0)), VIOLET),
              ("shared", m.get("Shmem", 0) / tot, pc(m.get("Shmem", 0)), VIOLET),
              ("swap", swu / swt if swt else 0, pc(swu, swt), VIOLET)]
    rows = [{"big": digits(used / tot * 100, 3), "unit": "%", "c": VIOLET, "side": side,
             "row": ("used", used / tot, f"{human(used)} of {human(tot)}", VIOLET)}]
    rows += [meters[i:i + 2] for i in range(0, len(meters), 2)] if s.h < 40 else meters
    hero = {"color": VIOLET, "rows": rows, "rw": 56,
            "graphs": [(st["hist"]["mem"], 0, 100, f"{used / tot * 100:.0f}%  used", VIOLET)]}

    n = max(4, min(20, s.h // 3))
    top = top_mem(n)
    trows = [(f"{name}" + (f" x{cnt}" if cnt > 1 else ""), rss / tot, f"{human(rss):>7}", VIOLET) for name, rss, cnt in top]
    boxes = [{"title": "top", "icon": IC["mem"], "color": VIOLET, "right": "rss by program", "rows": trows,
              "lines": min(len(trows), 10)}]

    ds = th_hist(pn, "v:swap", swu / swt * 100 if swt else 0)
    srows = [("swap used", swu / swt if swt else 0, f"{human(swu)} / {human(swt)}", VIOLET),
             ("swap cached", None, human(m.get("SwapCached", 0)))]
    for line in (read("/proc/swaps", "") or "").splitlines()[1:]:
        f = line.split()
        if len(f) >= 5:
            sz, u = int(f[2]) * 1024, int(f[3]) * 1024
            srows.append((os.path.basename(f[0])[:14], u / sz if sz else 0, f"{human(u)} / {human(sz)}  p{f[4]}", VIOLET))
    for z in sorted(os.listdir("/sys/block")) if os.path.isdir("/sys/block") else []:
        mm = (read(f"/sys/block/{z}/mm_stat") or "").split() if z.startswith("zram") else []
        if len(mm) >= 2 and int(mm[0]):
            srows.append((f"{z} ratio", None, f"{int(mm[0]) / max(1, int(mm[1])):.1f}:1  {human(int(mm[0]))} in {human(int(mm[1]))}"))
    if m.get("Zswap"):
        srows.append(("zswap", None, f"{human(m.get('Zswapped', 0))} in {human(m['Zswap'])}"))
    boxes.append({"title": "swap", "color": VIOLET, "right": f"{swu / swt * 100:.0f}%" if swt else "none", "rows": srows,
                  "rw": 44, "graphs": [(ds, 0, 100, f"{swu / swt * 100 if swt else 0:.0f}%  swap", VIOLET)]})

    dc = th_hist(pn, "v:cache", cache / tot * 100)
    crows = [("page cache", m.get("Cached", 0) / tot, human(m.get("Cached", 0)), VIOLET),
             ("buffers", m.get("Buffers", 0) / tot, human(m.get("Buffers", 0)), VIOLET),
             ("reclaimable", m.get("SReclaimable", 0) / tot, human(m.get("SReclaimable", 0)), VIOLET),
             ("file active", m.get("Active(file)", 0) / tot, human(m.get("Active(file)", 0)), VIOLET),
             ("file inactive", m.get("Inactive(file)", 0) / tot, human(m.get("Inactive(file)", 0)), VIOLET),
             ("dirty", None, human(m.get("Dirty", 0))), ("writeback", None, human(m.get("Writeback", 0)))]
    boxes.append({"title": "cache", "color": VIOLET, "right": human(cache), "rows": crows, "rw": 44,
                  "graphs": [(dc, 0, 100, f"{cache / tot * 100:.0f}%  cache + buffers", VIOLET)]})
    # most important first: a short screen drops the last
    vw_layout(s, st, (IC["mem"], "memory", VIOLET, f"{tot / 2**30:.1f} GiB"), hero, boxes,
              1 if s.w < 60 else (2 if s.w < 200 else 3))

# ----------------------------------------------------------------- fans ----
def view_fans(s, st, cfg, pn):
    fans = thermal_channels()[1]
    if not fans:
        s.put(0, 0, "hwdeck fans: this machine has no hwmon fan channels", AMBER)
        return
    hot = fan_follows(vw_temps("cpu"))
    ncols = max(1, min(len(fans), (s.w - 4) // 28, 3))  # side by side while each is 28 wide
    cw = (s.w - 4 - 3 * (ncols - 1)) // ncols
    boxes = []
    for lab, key, rpm, lo, mx, tgt, man in fans:
        d = th_hist(pn, f"fan:{key}:{lab}", rpm)
        top = mx or max(max(d), 1)
        f = rpm / top
        hf = (hot[3] - 20) / (hot[4] - 20) if hot else 0
        mode = ("manual", AMBER) if man else ("auto", GREEN)
        big = {"big": digits(rpm, 4), "unit": "rpm", "c": ICE, "row": ("rpm", f, f"{rpm} rpm", ICE, TEXT)}
        if cw >= 48:                                     # room for the facts beside the readout
            big["side"] = [(IC["fan"], "speed", f"{f * 100:.0f}% of max"), ("", "target", f"{tgt} rpm" if tgt is not None else "--"),
                           ("", "mode", mode[0], mode[1])]
        follows = f"{hot[3]:.0f}°C" + ("" if hot[1].startswith("temp") else f" {hot[1]}") if hot else ""
        if s.h < 20:                                     # half a grid cell: mode sits in the heading
            rows = [big, ("speed", f, f"{f * 100:.0f}% tgt {tgt if tgt is not None else '--'}", ICE),
                    ("min-max", None, f"{lo if lo is not None else '--'}-{mx or '--'} rpm")]
        else:
            rows = [big, ("speed", f, f"{f * 100:3.0f}%", ICE),
                    ("target", (tgt or 0) / top, f"{tgt} rpm" if tgt is not None else "--", ICE),
                    ("min / max", None, f"{lo if lo is not None else '--'} / {mx or '--'} rpm"),
                    ("mode", None, mode[0], None, mode[1])]
        if hot:                                          # what the fan loop is answering to
            rows.append(("cpu temp" if s.h >= 20 else "follows", hf, follows, temp_c(hf), temp_c(hf)))
        boxes.append({"title": ascii_only(lab).lower(), "icon": IC["fan"], "color": ICE, "rows": rows, "rw": 48,
                      "keep_big": True, "spark": True, "right": f"{key} · {mode[0]}",
                      "graphs": [(d, 0, top, f"{rpm} rpm  {f * 100:.0f}%", ICE)]})
    spin = sum(1 for f in fans if f[2] > 0)
    vw_layout(s, st, (IC["fan"], "fans", ICE, f"{spin}/{len(fans)} spinning"), None, boxes, ncols)

# -------------------------------------------------------------- battery ----
def battery_info():
    """The first system battery and the mains adapters. Charge is charge_now / charge_full:
    `capacity` divides by the design capacity on some drivers (applesmc among them), which
    on a worn pack reads low. Energy-reporting batteries (µWh, power_now) work the same."""
    base = "/sys/class/power_supply"
    names = sorted(os.listdir(base)) if os.path.isdir(base) else []
    bat = next((n for n in names if read(f"{base}/{n}/type") == "Battery" and read(f"{base}/{n}/scope") != "Device"), None)
    if not bat:
        return None
    p = f"{base}/{bat}"
    b = {"name": bat, "unit": "Ah"}
    b["now"], b["full"], b["design"], b["cur"] = ivals(p, "charge_now", "charge_full", "charge_full_design", "current_now")
    b["volt"], b["vmin"], b["cycles"], b["cap"] = ivals(p, "voltage_now", "voltage_min_design", "cycle_count", "capacity")
    b["watts"] = abs(b["cur"]) * b["volt"] / 1e12 if b["cur"] is not None and b["volt"] else None
    if b["now"] is None:                                 # energy units: µWh and µW
        b["now"], b["full"], b["design"], pw = ivals(p, "energy_now", "energy_full", "energy_full_design", "power_now")
        b["unit"], b["watts"] = "Wh", abs(pw) / 1e6 if pw is not None else None
        b["cur"] = pw / b["volt"] * 1e6 if pw is not None and b["volt"] else None
    b["status"] = read(f"{p}/status") or "Unknown"
    b["model"] = " ".join(x for x in (read(f"{p}/manufacturer"), read(f"{p}/model_name")) if x)
    b["tech"] = read(f"{p}/technology")
    lim, src = None, None
    for f in (f"{p}/charge_control_end_threshold", "/sys/devices/platform/applesmc.768/charge_control_end_threshold"):
        v = read(f)
        if v and v.isdigit():
            lim, src = int(v), f
            break
    b["limit"], b["limit_src"] = lim, src
    b["ac"] = [(n, read(f"{base}/{n}/online") == "1") for n in names if read(f"{base}/{n}/type") == "Mains"]
    return b

def view_battery(s, st, cfg, pn):
    b = battery_info()
    if not b or not b["full"]:
        s.put(0, 0, "hwdeck battery: no system battery under /sys/class/power_supply", AMBER)
        return
    pct = b["now"] / b["full"] * 100
    ac = any(on for _, on in b["ac"])
    st_ = b["status"]
    cur = abs(b["cur"] or 0) / 1e6                       # amps
    u = 1e6
    if st_ == "Discharging" and cur > 0.01:
        hrs = b["now"] / u / cur
        eta = f"{int(hrs)}h {int(hrs * 60 % 60):02d}m to empty"
    elif st_ == "Charging" and cur > 0.01:
        goal = b["full"] * (b["limit"] or 100) / 100
        hrs = max(0, goal - b["now"]) / u / cur
        eta = f"{int(hrs)}h {int(hrs * 60 % 60):02d}m to {b['limit'] or 100}%"
    elif b["limit"] and ac and pct >= b["limit"] - 3:
        eta = f"held at the {b['limit']}% limit"
    else:
        eta = "on AC, not charging" if ac else "idle"
    sign = {"Charging": "+", "Discharging": "-"}.get(st_, "")
    way = {"Charging": "in", "Discharging": "out"}.get(st_, "")
    watts = b["watts"] or 0
    acc = charge_c(pct, b["limit"])                      # red when empty, yellow at half, green at the limit
    chg = lambda f: charge_c(f * 100, b["limit"])
    icon = IC["plug"] if ac else (chr(BAT_GLYPHS[min(10, max(0, round(pct / 10)))]) if NERD else "")
    unit = b["unit"]
    amt = lambda v: f"{v / u:.2f} {unit}"
    hl = b["full"] / b["design"] if b["design"] else None
    side = [(icon, "status", st_.lower()), ("", "time", eta), ("", "charge", f"{amt(b['now'])} of {amt(b['full'])}"),
            ("", "power", f"{sign}{watts:.1f} W {way}".strip() if watts > 0.05 else "no current")]
    if hl:
        side.append(("", "health", f"{hl * 100:.0f}% of design", chg(hl)))
    meters = [("charge", pct / 100, f"{pct:5.1f}%", acc),
              ("limit", (b["limit"] or 100) / 100, f"{b['limit']}%" if b["limit"] else "none", acc),
              ("kernel %", (b["cap"] or 0) / 100, f"{b['cap']}%" if b["cap"] is not None else "--", faint(acc, 0.6)),
              ("AC", None, ", ".join(f"{n} {'on' if on else 'off'}" for n, on in b["ac"]) or "no adapter", None, GREEN if ac else GREY)]
    rows = [{"big": digits(pct, 3), "unit": "%", "c": acc, "side": side,
             "row": ("charge", pct / 100, f"{pct:.0f}%  {st_.lower()}", acc, acc)}]
    rows += [meters[i:i + 2] for i in range(0, len(meters), 2)] if s.h < 40 else meters
    if s.h >= 40:
        rows.append("kernel % is capacity, which divides by the design charge")
    dpct = th_hist(pn, "v:batpct", pct)
    hero = {"color": acc, "rows": rows, "rw": 56, "graphs": [(dpct, 0, 100, f"{pct:.0f}%  charge", chg)]}

    boxes = []
    dw = th_hist(pn, "v:batw", watts)
    volt = (b["volt"] or 0) / u
    vmin = (b["vmin"] or 0) / u
    prows = [("watts", watts / max(max(dw), 10), f"{sign}{watts:.2f} W {way}".strip(), acc),
             ("current", None, f"{sign}{cur:.3f} A"),
             ("voltage", (volt - vmin) / (vmin * 0.15) if vmin else None, f"{volt:.3f} V", acc),
             ("min design", None, f"{vmin:.2f} V" if vmin else "--")]
    boxes.append({"title": "power", "icon": IC["plug"], "color": acc, "right": f"{sign}{watts:.1f} W", "rows": prows, "rw": 44,
                  "graphs": [(dw, 0, max(max(dw), 10), f"{sign}{watts:.1f} W {way}".strip(), acc)]})
    if hl:
        hrows = [("health", hl, f"{hl * 100:.0f}%", chg(hl), chg(hl)),
                 ("full now", None, amt(b["full"])), ("design", None, amt(b["design"])),
                 ("worn", None, f"{(1 - hl) * 100:.0f}% lost")]
        if b["cycles"] is not None:
            hrows.append(("cycles", min(1, b["cycles"] / 1000), f"{b['cycles']} of ~1000", acc))
        hrows.append(("cell", None, " ".join(x for x in (b["tech"], b["model"]) if x) or "--"))
        boxes.append({"title": "health", "icon": chr(BAT_GLYPHS[-1]) if NERD else "", "color": chg(hl),
                      "right": f"{hl * 100:.0f}%", "rows": hrows})
    # power before health before temperatures: most important first, a short screen drops the last
    tb = vw_temp_box(pn, vw_temps("battery"), "temp", "v:batt")
    if tb:
        boxes.append(tb)
    vw_layout(s, st, (icon, "battery", acc, ascii_only(b["model"] or b["name"])), hero, boxes,
              1 if s.w < 60 else (2 if s.w < 200 else 3))

# ---------------------------------------------------------------- power ----
def rapl_domains(pn):
    """[(name, watts or None)] for every RAPL domain (package, cores, uncore / gpu, dram, psys)
    and whether any counter could be read; most kernels keep energy_uj root-only. Watts come
    from the energy counter's change since the last frame."""
    root, out, readable = "/sys/class/powercap", [], False
    prev = pn.__dict__.setdefault("rapl_dom", {})
    now = time.time()
    for d in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        if not d.startswith("intel-rapl:"):
            continue
        name = (read(f"{root}/{d}/name") or d).replace("package-", "package ")
        e, w = read(f"{root}/{d}/energy_uj"), None
        if e and e.isdigit():
            readable, e = True, int(e)
            p = prev.get(d)
            if p and e >= p[0] and now > p[1]:
                w = (e - p[0]) / 1e6 / (now - p[1])
            prev[d] = (e, now)
        out.append((name, w))
    return out, readable

def proc_cpu(pn, n):
    """CPU share per program name since the last frame, as % of all cores, from
    /proc/*/stat utime + stime: one small read per process. A cheap stand-in for who is
    drawing the power."""
    now, agg, t = {}, {}, time.time()
    for pid in os.listdir("/proc"):
        f = read(f"/proc/{pid}/stat") if pid.isdigit() else None
        if f and ")" in f:
            r = f.rfind(")")
            x = f[r + 2:].split()
            now[pid] = (f[f.find("(") + 1: r], int(x[11]) + int(x[12]))
    prev, pt = pn.__dict__.get("procs", ({}, t))
    pn.procs = (now, t)
    if not prev or t <= pt:
        return []
    for pid, (comm, ticks) in now.items():
        if pid in prev and ticks > prev[pid][1]:
            agg[comm] = agg.get(comm, 0) + ticks - prev[pid][1]
    scale = 100 / os.sysconf("SC_CLK_TCK") / (t - pt) / (os.cpu_count() or 1)
    return sorted(((ascii_only(c), v * scale) for c, v in agg.items()), key=lambda r: -r[1])[:n]

def view_power(s, st, cfg, pn):
    b = battery_info()
    doms, readable = rapl_domains(pn)
    ac = any(on for _, on in b["ac"]) if b else None
    st_ = b["status"] if b else "no battery"
    watts = (b["watts"] or 0) if b else 0
    sign = {"Charging": "+", "Discharging": "-"}.get(st_, "")
    way = {"Charging": "into the battery", "Discharging": "system draw"}.get(st_, "battery idle")
    pkg = next((w for n, w in doms if n.startswith("package")), None)
    dw = th_hist(pn, "v:pw", watts)
    top = max(max(dw), 10)

    # the readout is what the battery sees: on battery that is the whole system's draw
    side = [(IC["plug"] if ac else IC["bat"], "source", "AC adapter" if ac else ("battery" if b else "--")),
            ("", "battery", f"{sign}{watts:.1f} W  {st_.lower()}" if b else "none")]
    if b and b["full"]:
        side.append(("", "charge", f"{b['now'] / b['full'] * 100:.0f}%", charge_c(b["now"] / b["full"] * 100, b["limit"])))
    side.append((IC["cpu"], "package", f"{pkg:.1f} W" if pkg is not None else ("reading..." if readable else "not readable yet"),
                 TEXT if pkg is not None else GREY))
    rows = [{"big": f"{watts:4.1f}".replace(" ", "_"), "unit": "W", "c": VOLT, "side": side,
             "row": ("watts", watts / top, f"{sign}{watts:.1f} W  {way}", VOLT)}]
    hero = {"color": VOLT, "rows": rows, "rw": 56, "graphs": [(dw, 0, top, f"{sign}{watts:.1f} W  {way}", VOLT)]}

    boxes = []
    if readable:
        rr = [(n, (w or 0) / max(pkg or 0, w or 0, 1), f"{w:.2f} W" if w is not None else "--", VOLT) for n, w in doms]
        dp = th_hist(pn, "v:rapl", pkg or 0)
        boxes.append({"title": "rapl", "icon": IC["cpu"], "color": VOLT, "right": f"{pkg:.1f} W" if pkg is not None else "",
                      "rows": rr, "rw": 44, "graphs": [(dp, 0, max(max(dp), 5), f"{pkg or 0:.1f} W  package", VOLT)]})
    else:
        boxes.append({"title": "rapl", "icon": IC["cpu"], "color": GREY, "right": "not readable yet",
                      "rows": [(n_, None, "locked", None, GREY) for n_, _ in doms]
                      + ["energy_uj is root-only here;", "lights up once readable"] if doms else ["no RAPL counters"]})
    n = max(4, min(15, s.h // 3))
    procs = proc_cpu(pn, n)
    prow = [(name, v / 100, f"{v:5.1f}%", VOLT) for name, v in procs] or ["measuring..."]
    boxes.append({"title": "top", "icon": IC["cpu"], "color": VOLT, "right": "cpu share", "rows": prow,
                  "lines": max(1, min(len(prow), 8))})
    if b:
        boxes.append({"title": "ac", "icon": IC["plug"], "color": GREEN if ac else GREY, "right": "online" if ac else "offline",
                      "rows": [(n_, None, "online" if on else "offline", None, GREEN if on else GREY) for n_, on in b["ac"]]
                      + [("current", None, f"{sign}{abs(b['cur'] or 0) / 1e6:.3f} A"), ("voltage", None, f"{(b['volt'] or 0) / 1e6:.2f} V")]})
    vw_layout(s, st, (IC["plug"] if ac else IC["bat"], "power", VOLT, way), hero, boxes,
              1 if s.w < 60 else (2 if s.w < 200 else 3))

# -------------------------------------------------------------- network ----
LIME = (0.62, 0.90, 0.32)                                # the strip's Wi-Fi green, kept apart from battery green
WIFI_GLYPHS = (0xF091F, 0xF0922, 0xF0925, 0xF0928)       # 1 .. 4 bars, as the strip

def default_route():
    """(interface, gateway) of the IPv4 default route, from /proc/net/route."""
    for line in (read("/proc/net/route", "") or "").splitlines()[1:]:
        f = line.split()
        if len(f) > 2 and f[1] == "00000000":
            return f[0], ".".join(str(b) for b in bytes.fromhex(f[2])[::-1])
    return None, None

def wifi_info():
    """The Wi-Fi link: interface, SSID, frequency, signal and bitrates. `iw dev <if> link`
    needs no root; without iw, /proc/net/wireless gives the signal and nmcli the rest."""
    base = "/sys/class/net"
    ifs = [n for n in sorted(os.listdir(base)) if os.path.isdir(f"{base}/{n}/wireless")] if os.path.isdir(base) else []
    if not ifs:
        return None
    w = {"if": ifs[0]}
    for line in run("iw", "dev", ifs[0], "link", timeout=1).splitlines():
        k, _, v = line.strip().partition(": ")
        if k in ("SSID", "freq", "signal", "rx bitrate", "tx bitrate"):
            w[k] = v
    if "signal" not in w:
        for line in (read("/proc/net/wireless", "") or "").splitlines()[2:]:
            if line.split(":")[0].strip() == ifs[0] and len(line.split()) > 3:
                w["signal"] = line.split()[3].rstrip(".")
    if "SSID" not in w:
        for line in run("nmcli", "-t", "-f", "ACTIVE,SSID,FREQ,RATE", "dev", "wifi", timeout=1).splitlines():
            f = line.split(":")
            if f[0] == "yes" and len(f) >= 4:
                w.update({"SSID": f[1], "freq": f[2].split()[0], "tx bitrate": f[3]})
                break
    for k in ("rx bitrate", "tx bitrate"):                # "400.0 MBit/s VHT-MCS 9 ..." -> "400 Mb/s"
        m = re.match(r"([\d.]+)", w.get(k, ""))
        if m:
            w[k] = f"{float(m.group(1)):g} Mb/s"
    try:
        w["dbm"] = int(float(w["signal"].split()[0]))
        w["q"] = max(0, min(100, 2 * (w["dbm"] + 100)))  # the strip's 0-100
    except (KeyError, ValueError, IndexError):
        pass
    try:
        mhz = float(w["freq"])
        w["band"] = "2.4 GHz" if mhz < 2500 else ("5 GHz" if mhz < 5925 else "6 GHz")
        w["ch"] = round((mhz - (2407 if mhz < 2500 else 5000 if mhz < 5925 else 5950)) / 5)
    except (KeyError, ValueError):
        pass
    return w

def ipv4(iface):
    m = re.search(r"inet (\S+)", run("ip", "-4", "-o", "addr", "show", "dev", iface, timeout=1)) if iface else None
    return m.group(1) if m else None

def tailscale(pn):
    """`tailscale status --json` (no root; ~30 ms), at most every 15 s; None without tailscale."""
    c = pn.__dict__.get("ts")
    if c and time.time() - c[0] < 15:
        return c[1]
    try:
        d = json.loads(run("tailscale", "status", "--json", timeout=1) or "null")
    except ValueError:
        d = None
    out = None
    if isinstance(d, dict):
        peers = list((d.get("Peer") or {}).values())
        out = {"state": d.get("BackendState") or "--", "ip": ((d.get("Self") or {}).get("TailscaleIPs") or ["--"])[0],
               "peers": len(peers), "online": sum(1 for p in peers if p.get("Online")),
               "exit": next((p.get("HostName") for p in peers if p.get("ExitNode")), None)}
    pn.ts = (time.time(), out)
    return out

def net_rate(pn, iface):
    """Bytes per second down and up on one interface since the last frame, raw (for the
    graphs) and smoothed by an exponential moving average over about 5 s (for the readout)."""
    nd, now = netdev(), time.time()
    prev = pn.__dict__.get("netp")
    pn.netp = (iface, nd.get(iface), now)
    raw = (0.0, 0.0)
    if prev and prev[0] == iface and prev[1] and iface in nd and now > prev[2]:
        raw = tuple(max(0.0, (a - b) / (now - prev[2])) for a, b in zip(nd[iface], prev[1]))
        k = 1 - 2.718281828 ** (-(now - prev[2]) / 5)
        old = pn.__dict__.get("nema")
        pn.nema = raw if old is None else tuple(o + (r - o) * k for o, r in zip(old, raw))
    return raw, pn.__dict__.get("nema") or raw

RATE_UNITS = (("B/s", 1), ("KB/s", 1e3), ("MB/s", 1e6), ("GB/s", 1e9))

def rate_unit(v):
    return next((i for i, (_, d) in enumerate(RATE_UNITS) if v / d < 1000), len(RATE_UNITS) - 1)

def steady_unit(pn, v, key="nunit", hold=4):
    """A rate's display unit, which moves only after the value has wanted another unit (past
    1000 of this one, or under 1) for `hold` seconds; meanwhile the digits clamp at 999.9."""
    want, now = rate_unit(v), time.time()
    cur, since = pn.__dict__.get(key, (None, None))
    if cur is None or want == cur:
        since = None
    elif since is None:
        since = now
    elif now - since >= hold:
        cur, since = want, None
    pn.__dict__[key] = (want if cur is None else cur, since)
    return pn.__dict__[key][0]

def steady_rate(pn, v, key):
    """A smoothed rate at a fixed width: always "ddd.d unit", in its steady unit."""
    u = steady_unit(pn, v, key)
    return f"{min(v / RATE_UNITS[u][1], 999.9):5.1f} {RATE_UNITS[u][0]:<4}"

def rate(v, u=None):
    """Bytes/s as text in its own (or the given) unit: 12.3 KB/s."""
    u = rate_unit(v) if u is None else u
    return f"{v / RATE_UNITS[u][1]:.1f} {RATE_UNITS[u][0]}"

def dns_servers(iface):
    """The resolvers in use: resolvectl's for the interface behind systemd-resolved's stub
    (no root, ~5 ms), else resolv.conf's."""
    ns = re.findall(r"^nameserver\s+(\S+)", read("/etc/resolv.conf", "") or "", re.M)
    if iface and all(n.startswith("127.") for n in ns):
        out = run("resolvectl", "dns", iface, timeout=1)
        ns = out.split(":", 1)[1].split() if ":" in out else ns
    return ns

def iface_totals():
    """Bytes down and up since boot on every interface but lo, from /proc/net/dev."""
    out = []
    for line in (read("/proc/net/dev", "") or "").splitlines()[2:]:
        name, rest = line.split(":", 1)
        f = rest.split()
        if name.strip() != "lo" and len(f) > 8:
            out.append((name.strip(), int(f[0]), int(f[8])))
    return out

def view_network(s, st, cfg, pn):
    route, gw = default_route()
    w = wifi_info()
    iface = cfg.get("net_interface") or route or (w or {}).get("if")
    (down, up), (sd, su) = net_rate(pn, iface)
    drx, dtx = th_hist(pn, "v:rx", down), th_hist(pn, "v:tx", up)     # the graphs stay raw
    ip = ipv4(iface)
    ts = tailscale(pn)
    q = (w or {}).get("q")
    icon = chr(WIFI_GLYPHS[min(3, q // 25)]) if NERD and q is not None else (IC["net"] if w else "")
    # the readout is the Wi-Fi signal on the strip's 0-100, the mean of the last three samples
    # so it does not flicker; the rates sit beside it, smoothed and at a fixed width
    dq = th_hist(pn, "v:q", q) if q is not None else None
    sig = round(sum(list(dq)[-3:]) / len(list(dq)[-3:])) if dq else None
    down_t, up_t = steady_rate(pn, sd, "nu_down"), steady_rate(pn, su, "nu_up")
    side = []
    if w and w.get("SSID"):
        side.append((icon, "wifi", w["SSID"]))
        side.append(("", "link", " · ".join(x for x in (f"{w['dbm']} dBm" if q is not None else None, w.get("band"),
                                                        w.get("rx bitrate") or w.get("tx bitrate")) if x)))
    else:
        side.append((icon, "wifi", "no wifi", GREY))
        side.append(("", "link", iface or "none"))
    side += [("", "down", down_t), ("", "up", up_t), ("", "ipv4", ip or "--")]
    sc = charge_c(sig, 100) if sig is not None else GREY
    rows = [{"big": digits(sig, 3) if sig is not None else "_--", "unit": "%", "c": LIME, "side": side,
             "row": [("signal", (sig or 0) / 100, f"{sig}%" if sig is not None else "no wifi", sc, sc),
                     ("down", None, f"{down_t.strip()}   up {up_t.strip()}")]}]   # the fallback keeps the rates
    top_ = max(max(drx), max(dtx), 1024)
    hero = {"color": LIME, "rows": rows, "rw": 56, "across": True, "grow": 1,
            "graphs": [(drx, 0, top_, f"down {rate(down)}", LIME), (dtx, 0, top_, f"up {rate(up)}", LIME)]}

    boxes = []
    if s.h >= 20:                                        # half a grid cell holds the hero alone
        if w:
            wr = [("ssid", None, w.get("SSID") or "not connected")]
            if q is not None:
                wr.append(("signal", q / 100, f"{w['dbm']} dBm  {q}", charge_c(q, 100)))
            if w.get("freq"):
                wr.append(("band", None, f"{w.get('band', '')} ch {w.get('ch', '--')} {float(w['freq']):.0f}"))
            wr.append(("rx / tx", None, " / ".join(w.get(k, "--").replace(" Mb/s", "") for k in ("rx bitrate", "tx bitrate")) + " Mb/s"))
            boxes.append({"title": "wifi", "icon": icon, "color": LIME, "right": w["if"], "rows": wr})
        if ts:
            boxes.append({"title": "tailscale", "color": LIME, "right": ts["state"].lower(), "rows": [
                ("address", None, ts["ip"]),
                ("peers", ts["online"] / max(1, ts["peers"]), f"{ts['online']}/{ts['peers']} online", LIME),
                ("exit node", None, ts["exit"] or "none")]})
        boxes.append({"title": "ip", "color": LIME, "right": iface or "", "rows": [
            ("ipv4", None, ip or "--"), ("gateway", None, gw or "--"), ("dns", None, " ".join(dns_servers(iface)[:2]) or "--")]})
        boxes.append({"title": "since boot", "color": LIME, "right": "down / up", "rows": [
            (n, None, ((human(rx), TEXT), (" / ", GREY), (human(tx), TEXT))) for n, rx, tx in iface_totals()]})
    note = f"tailscale {ts['state'].lower()} · {ts['online']}/{ts['peers']} online" if ts else (iface or "")
    vw_layout(s, st, (icon or IC["net"], "network", LIME, note), hero, boxes, 1 if s.w < 60 else (2 if s.w < 200 else 3))

def draw_view(s, st, cfg, pn, name):
    {"cpu": view_cpu, "memory": view_memory, "fans": view_fans, "battery": view_battery,
     "power": view_power, "network": view_network, "thermal": draw_thermal}[name](s, st, cfg, pn)

def main():
    global CHROME
    ap = argparse.ArgumentParser(description="one-page hardware dashboard for a terminal or Linux console")
    ap.add_argument("--config", default=os.path.expanduser("~/.config/hwdeck/config.toml"))
    ap.add_argument("--interval", type=float, default=None, help="seconds between refreshes (default 2)")
    ap.add_argument("--once", action="store_true", help="draw one frame and exit (for testing)")
    ap.add_argument("--no-orbit", action="store_true",
                    help="views: no burn-in protection (pixel orbit and dimmed chrome); also orbit = false in the config")
    ap.add_argument("--style", choices=["bunker", "btop", "eq", "panel", "glance", "thermal"],
                    help="btop: btop-like boxes (default); bunker: heavy chassis of meters; eq: equalizer bars; panel: control-room lamps; glance: big numerals; thermal: every temperature sensor and fan, by zone. eq/panel need 120x46")
    ap.add_argument("--view", choices=VIEWS,
                    help="one thing full screen instead of a style: cpu, memory, fans, battery, power, network, or thermal (the same as --style thermal)")
    ap.add_argument("--version", action="version", version=f"hwdeck {VERSION}")
    args = ap.parse_args()

    cfg = {}
    if os.path.exists(args.config):
        if tomllib is None:
            sys.exit("hwdeck: a config file needs Python 3.11+ (tomllib)")
        with open(args.config, "rb") as f:
            cfg = tomllib.load(f)
    interval = args.interval or cfg.get("interval", 2.0)
    # Burn-in protection for the views, which stay up for hours with static frames and labels:
    # the drawing orbits one cell through (0,0) (1,0) (1,1) (0,1) every ORBIT seconds inside a
    # spare column and row, and after DIM seconds the chrome drops a step (live values do not).
    orbit = not args.no_orbit and cfg.get("orbit", True)
    orbit_s = float(os.environ.get("HWDECK_ORBIT_SECONDS") or 180)
    dim_s = float(os.environ.get("HWDECK_DIM_SECONDS") or 1800)
    started = time.time()
    svc_cfg = cfg.get("services", {})
    extra_cmds = cfg.get("extra", {}).get("commands", [])

    cpu, gpu = Cpu(), Gpu()
    style = args.view or args.style or cfg.get("style", "btop")
    pn = Panel()
    hist = {k: deque(maxlen=HIST) for k in ("cpu", "gpu", "gpw", "mem", "rx", "tx")}
    last_net, last_io, slow_t = None, None, 0
    services, extra = [], []
    cpu.sample()                                          # prime the deltas
    pn.counters.sample()
    if style == "power":                                  # prime the RAPL and per-process deltas
        rapl_domains(pn)
        proc_cpu(pn, 0)
    if style == "network":                                # and the interface's byte counters
        net_rate(pn, cfg.get("net_interface") or default_route()[0] or (wifi_info() or {}).get("if"))
    # a view paints pure black; OSC 11 turns the terminal's own background (foot's padding) black
    # too, and OSC 111 gives it back on exit. The kernel console has no use for either.
    paint = style in VIEWS and NERD and not args.once
    if not args.once:
        sys.stdout.write(ESC + "?25l" + ESC + "2J" + ("\x1b]11;#000000\x1b\\" if paint else ""))
    try:
        while True:
            t0 = time.time()
            if args.once:
                time.sleep(1)
            total, cores, freq = cpu.sample()
            g = gpu.sample()
            mem = memory()
            temps, fans = sensors()
            nd = netdev()
            iface = cfg.get("net_interface") or max(nd, key=lambda k: sum(nd[k]), default=None)
            rx = tx = 0.0
            if iface in nd and last_net and last_net[0] == iface:
                dt = t0 - last_net[3]
                rx, tx = (nd[iface][0] - last_net[1]) / dt, (nd[iface][1] - last_net[2]) / dt
            if iface in nd:
                last_net = (iface, nd[iface][0], nd[iface][1], t0)
            io = diskio()
            io_rate = (0.0, 0.0)
            if last_io:
                dt = t0 - last_io[2]
                io_rate = ((io[0] - last_io[0]) / dt, (io[1] - last_io[1]) / dt)
            last_io = (io[0], io[1], t0)
            if t0 - slow_t > 15:
                services = service_states(svc_cfg)
                extra = [(run("sh", "-c", c, timeout=5).strip().splitlines() or [""])[0] for c in extra_cmds]
                slow_t = t0
            for k, v in (("cpu", total), ("gpu", g.get("busy", 0)), ("mem", mem["used"] / mem["total"] * 100),
                         ("rx", rx), ("tx", tx), ("gpw", g.get("power") or 0)):
                hist[k].append(v)
            w, h = shutil.get_terminal_size((128, 48))
            s = Screen(w, h, BLACK if style in VIEWS else None)
            state = {"hist": hist, "host": socket.gethostname(), "uptime": float((read("/proc/uptime", "0") or "0").split()[0]),
                     "load": os.getloadavg(), "cpu_model": cpu.model, "gpu_name": gpu.name, "gpu_kind": gpu.kind,
                     "kernel": f"{os.uname().sysname} {os.uname().release}", "cpu": total, "cores": cores,
                     "cpu_freq": freq, "gpu": g, "mem": mem, "temps": temps, "fans": fans, "net": (iface, rx, tx),
                     "disks": mounts(), "io": io_rate, "services": services, "extra": extra, "interval": interval}
            if style in VIEWS and w >= 50 and h >= 10:      # views fit themselves to a small terminal
                up = time.time() - started
                CHROME = 0.65 if orbit and up >= dim_s else 1.0
                if orbit:                                     # one offset for the whole frame
                    ox, oy = ((0, 0), (1, 0), (1, 1), (0, 1))[int(up // orbit_s) % 4]
                    v = Screen(w - 1, h - 1, BLACK)
                    draw_view(v, state, cfg, pn, style)
                    for y, row in enumerate(v.cells):
                        s.cells[y + oy][ox: ox + w - 1] = row
                else:
                    draw_view(s, state, cfg, pn, style)
            elif w < 100 or h < 40:
                s.put(0, 0, f"hwdeck needs at least 100x40, this terminal is {w}x{h}", "Y")
            elif style == "btop" and w >= 128 and h >= 46:
                draw_btop(s, state, cfg, pn)
            elif style == "bunker" and w >= 128 and h >= 46:
                draw_bunker(s, state, cfg, pn)
            elif style == "eq" and w >= 120 and h >= 46:
                draw_eq(s, state, cfg, pn)
            elif style == "panel" and w >= 120 and h >= 46:
                draw_panel(s, state, cfg, pn)
            else:
                draw(s, state, cfg)
            sys.stdout.write(s.render())
            sys.stdout.flush()
            if args.once:
                return
            time.sleep(max(0.1, interval - (time.time() - t0)))
    except KeyboardInterrupt:
        pass
    finally:
        if not args.once:
            sys.stdout.write(ESC + "0m" + ESC + "?25h" + ESC + "2J" + ESC + "H" + ("\x1b]111\x1b\\" if paint else ""))

if __name__ == "__main__":
    main()
