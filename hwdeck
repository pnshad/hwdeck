        hbar(s, cx[3], y + 2 + i * 2, iw_, f)
    top_io = max(st["io"][0], st["io"][1], 1)
    readout(s, cx[3], y + 5, "RD", f"{st['io'][0] / 2**20:06.2f}M", INK2)
    readout(s, cx[3], y + 6, "WR", f"{st['io'][1] / 2**20:06.2f}M", INK2)
    top = max(max(st["hist"]["rx"], default=0), max(st["hist"]["tx"], default=0), 64 * 1024)
    readout(s, cx[3], y + 7, "RX", f"{rx / 1024:07.1f}K", "C")
    trace(s, cx[3], y + 8, iw_, 2, st["hist"]["rx"], 0, top, "C")
    readout(s, cx[3], y + 10, "TX", f"{tx / 1024:07.1f}K", "M")
    trace(s, cx[3], y + 11, iw_, 2, st["hist"]["tx"], 0, top, "M")

    # ============================================================== THERMAL =========
