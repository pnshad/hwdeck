    header(s, 0, y, w, "thermal // cooling", f"{len(temps_all):02d} TEMP  {len(st['fans']):02d} FAN  {len(pwms):02d} PWM")
    gshort = {"Board": "BRD", "NVMe": "NVME", "Wi-Fi": "WIFI"}
