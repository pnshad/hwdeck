    readout(s, rx2, y + 2, "TOT", f"{m['total'] / 2**30:05.1f}G", INK2)
    readout(s, rx2, y + 3, "CAC", f"{m['cached'] / 2**30:05.1f}G", INK2)
    readout(s, rx2, y + 4, "AVL", f"{m['avail'] / 2**30:05.1f}G", INK2)
