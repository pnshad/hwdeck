    gv = next((v for grp, name, v in volts if grp == "GPU"), None)
    fq_all = core_freqs(len(cores))
    fmax = max((mx for _, mx in fq_all), default=0)
    favg = sum(c for c, _ in fq_all) / len(fq_all) if fq_all else 0
    duty = [p[2] for p in pwms if p[3] not in ("0", None)]
    budget = [("GPU PPT", (gpow / gcap) if gpow is not None and gcap else 0, f"{gpow or 0:03.0f}/{gcap:03.0f}W"),
              ("GPU VDD", ((gv or 0) - 0.7) / 0.5, f"{(gv or 0) * 1000:04.0f}mV"),
              ("GPU SCLK", (g.get("sclk") or 0) / (g.get("sclk_max") or 1), f"{g.get('sclk') or 0:04.0f}/{g.get('sclk_max') or 0:04.0f}"),
              ("GPU MCLK", (g.get("mclk") or 0) / (g.get("mclk_max") or 1), f"{g.get('mclk') or 0:04.0f}/{g.get('mclk_max') or 0:04.0f}"),
              ("CPU CLK", favg / fmax if fmax else 0, f"{favg:03.1f}/{fmax:03.1f}G"),
              ("VRAM", (g["vram_used"] / g["vram_total"]) if g.get("vram_total") else 0,
               f"{(g.get('vram_used') or 0) / 2**30:03.1f}/{(g.get('vram_total') or 0) / 2**30:02.0f}G"),
              ("FAN DUTY", sum(duty) / len(duty) if duty else 0, f"{(sum(duty) / len(duty) * 100) if duty else 0:03.0f}% AVG"),
              ("MEMORY", m["used"] / m["total"], f"{m['used'] / 2**30:04.1f}G"),
              ("CPU LOAD", st["cpu"] / 100, f"{st['cpu']:05.1f}%"),
              ("GPU BUSY", g.get("busy", 0) / 100, f"{g.get('busy', 0):05.1f}%"),
              ("DISK /", (root[1] / root[2]) if root else 0, f"{(root[1] / root[2] * 100) if root else 0:05.1f}%"),
              ("SWAP", (m["swap_used"] / m["swap_total"]) if m["swap_total"] else 0, f"{m['swap_used'] / 2**30:04.1f}G")]
    for i, (name, f, val) in enumerate(budget[: ph - 1]):
        yy = py + 1 + i
        s.put(x1, yy, name.ljust(9), DIM)
        hbar(s, x1 + 9, yy, pw_ - 9 - 13, max(0.0, min(1.0, f)))
        s.put(x1 + pw_ - 12, yy, val.rjust(12)[:12], INK2)
    by = py
    for model, cap, status in bats[:3]:
        s.put(x2, by, f"BAT {model.upper()}"[: pw_ - 12], DIM)
        hbar(s, x2 + pw_ - 11, by, 6, cap / 100, "G" if cap > 30 else "Y")
        s.put(x2 + pw_ - 4, by, f"{cap:3d}%", INK2)
        by += 1
    for name, al in intr:
        lamp(s, x2 + (pw_ // 2) * (int(name[-1]) % 2 if name[-1].isdigit() else 0), by, pw_ // 2 - 1,
             f"{name.replace('INTRUSION', 'CHASSIS ')} {'OPENED' if al else 'SHUT'}", 2 if al else 1, blink)
        if not name[-1].isdigit() or int(name[-1]) % 2 == 1:
            by += 1
    # services lamps and the event log share the last lines of the third column
    for u, stt in st["services"]:
        if by >= h - 1:
            break
        lamp(s, x2, by, pw_, ascii_only(u).upper()[:pw_], 1 if stt == "active" else 4, blink)
        by += 1
    evs = list(pn.log)
    if by < h - 1:
        s.put(x2, by, "EVENT LOG".ljust(pw_, " "), DIM)
